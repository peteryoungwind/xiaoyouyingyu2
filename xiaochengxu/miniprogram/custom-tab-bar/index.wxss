.tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  border-top: 1rpx solid rgba(60, 60, 67, 0.10);
}

.tabbar-wrap {
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 18rpx;
}

.tabbar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.tabbar-icon-badge {
  width: 56rpx;
  height: 40rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tabbar-icon-badge-active {
  background: #EAF3FF;
}

.tabbar-icon {
  width: 46rpx;
  height: 46rpx;
}

.tabbar-text {
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 500;
}
