.warmup-page {
  background: #F5F5F7;
}

.warmup-hero {
  padding: 8rpx 0 26rpx;
}

.warmup-title {
  font-size: 58rpx;
  line-height: 1.15;
  font-weight: 800;
  color: #1D1D1F;
}

.warmup-subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #6E6E73;
}

.search-card {
  padding: 26rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  border: 2rpx solid #E5E5EA;
  box-shadow: 0 14rpx 36rpx rgba(17, 24, 39, 0.04);
}

.search-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 78rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: #F5F7FA;
  font-size: 28rpx;
  color: #1D1D1F;
}

.placeholder {
  color: #A1A1AA;
}

.search-btn,
.retry-btn {
  height: 78rpx;
  padding: 0 28rpx;
  border-radius: 22rpx;
  background: #007AFF;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.date-row {
  margin-top: 18rpx;
  display: flex;
  gap: 14rpx;
  align-items: center;
  flex-wrap: wrap;
}

.date-pill,
.date-clear {
  height: 62rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #F4F8FF;
  border: 2rpx solid #D8E8FF;
  color: #007AFF;
  font-size: 24rpx;
  display: flex;
  align-items: center;
}

.date-clear {
  background: #FFF5F5;
  border-color: #FFD6D6;
  color: #D92D20;
}

.tag-grid {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-pill {
  max-width: 180rpx;
  height: 58rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #F5F5F7;
  color: #6E6E73;
  font-size: 23rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tag-pill.active {
  background: #EAF3FF;
  color: #007AFF;
  font-weight: 700;
}

.tag-pill.all {
  background: #007AFF;
  color: #FFFFFF;
}

.topic-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.topic-card {
  padding: 30rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 2rpx solid #E5E5EA;
  box-shadow: 0 14rpx 36rpx rgba(17, 24, 39, 0.04);
}

.topic-title {
  font-size: 31rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #1D1D1F;
}

.topic-sub {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.45;
  color: #6E6E73;
}

.topic-meta {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #8E8E93;
}

.topic-tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.topic-tag {
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #F4F8FF;
  color: #007AFF;
  font-size: 22rpx;
  line-height: 42rpx;
}

.state-wrap {
  padding: 72rpx 0;
  text-align: center;
  color: #8E8E93;
  font-size: 27rpx;
}

.state-wrap.small {
  padding: 28rpx 0;
  font-size: 24rpx;
}

.state-wrap .retry-btn {
  width: 160rpx;
  margin: 24rpx auto 0;
}
