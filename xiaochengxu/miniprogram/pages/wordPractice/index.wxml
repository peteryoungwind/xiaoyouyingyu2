<view class="page-container safe-bottom practice-page">
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:elif="{{completed}}" class="complete-card">
    <view class="complete-title">今天这一组完成了</view>
    <view class="complete-desc">没有到期复习词，也没有新的已发布单词。</view>
    <button class="secondary-btn" bindtap="loadNext">再检查一次</button>
  </view>

  <view wx:elif="{{word}}" class="practice-card">
    <view class="progress-line" wx:if="{{progress}}">
      已学 {{progress.learned || 0}} / {{progress.total || 0}} · 待复习 {{progress.dueReview || 0}} · 掌握 {{progress.mastered || 0}}
    </view>
    <view class="word">{{word.word}}</view>
    <view class="phonetic" wx:if="{{word.phonetic}}">{{word.phonetic}}</view>

    <view class="audio-row">
      <button class="audio-btn" bindtap="playAudio" data-url="{{word.audioUsUrl}}">
        <image class="audio-icon" src="/images/icons/volume.svg" mode="aspectFit" />
        <text>美式发音</text>
      </button>
      <button class="audio-btn" bindtap="playAudio" data-url="{{word.audioUkUrl}}">
        <image class="audio-icon" src="/images/icons/volume.svg" mode="aspectFit" />
        <text>英式发音</text>
      </button>
    </view>

    <view class="answer-row" wx:if="{{!detailVisible}}">
      <button class="answer-btn unknown" bindtap="answer" data-result="UNKNOWN" loading="{{submitting}}">不认识</button>
      <button class="answer-btn known" bindtap="answer" data-result="KNOWN" loading="{{submitting}}">认识</button>
    </view>

    <view class="inline-detail" wx:if="{{detailVisible}}">
      <view class="section">
        <view class="label">中文释义</view>
        <view class="text">{{word.definitionZh}}</view>
      </view>
      <view class="section" wx:if="{{word.definitionEn}}">
        <view class="label">英文释义</view>
        <view class="text">{{word.definitionEn}}</view>
      </view>
      <view class="section" wx:if="{{word.commonPatterns}}">
        <view class="label">常用搭配/句型</view>
        <view class="text">{{word.commonPatterns}}</view>
      </view>
      <view class="section" wx:if="{{word.exampleEn || word.exampleZh}}">
        <view class="label">例句</view>
        <view class="text strong">{{word.exampleEn}}</view>
        <view class="text zh">{{word.exampleZh}}</view>
        <view class="audio-row small">
          <button class="audio-btn" bindtap="playAudio" data-url="{{word.exampleAudioUsUrl}}">
            <image class="audio-icon" src="/images/icons/volume.svg" mode="aspectFit" />
            <text>美式发音</text>
          </button>
          <button class="audio-btn" bindtap="playAudio" data-url="{{word.exampleAudioUkUrl}}">
            <image class="audio-icon" src="/images/icons/volume.svg" mode="aspectFit" />
            <text>英式发音</text>
          </button>
        </view>
      </view>
      <view class="section" wx:if="{{word.sourceScene || word.sourceTopicTitle}}">
        <view class="label">来源</view>
        <view class="text">{{word.sourceScene || word.sourceTopicTitle}}</view>
      </view>
      <button class="secondary-btn" bindtap="loadNext">下一词</button>
    </view>
  </view>
</view>
