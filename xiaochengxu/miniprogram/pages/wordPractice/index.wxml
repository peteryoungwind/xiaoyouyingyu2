<view class="page-container safe-bottom practice-page {{detailVisible ? 'detail-mode' : 'recall-mode'}}">
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:elif="{{completed}}" class="review-page">
    <view class="review-header">
      <view class="round-icon" bindtap="goBack">‹</view>
      <view class="review-title-wrap">
        <view class="eyebrow">Review</view>
        <view class="review-title">练习复盘</view>
      </view>
      <view class="round-icon" bindtap="goBack">×</view>
    </view>

    <view class="result-card">
      <view class="eyebrow">Today</view>
      <view class="result-title">本轮完成 {{sessionStats.total}} 个单词</view>
      <view class="result-desc">认识 {{sessionStats.known}} 个，模糊 {{sessionStats.fuzzy}} 个，不认识 {{sessionStats.unknown}} 个。系统已自动安排下一次复习。</view>
      <view class="score-row">
        <view><text>{{sessionStats.familiarRate}}%</text><text>熟悉率</text></view>
        <view><text>+{{sessionStats.total}}</text><text>本轮记录</text></view>
      </view>
    </view>

    <view class="result-card switch-card">
      <view class="card-row">
        <view>
          <view class="eyebrow">Current Book</view>
          <view class="section-title">继续当前词书</view>
        </view>
        <view class="text-action" bindtap="goToBooks">换词书</view>
      </view>
      <view class="book-summary">
        <view>
          <view class="book-summary-name">{{bookTitle}}</view>
          <view class="book-summary-desc">{{reviewSummary}}</view>
        </view>
        <view class="active-mark">✓</view>
      </view>
    </view>

    <view class="review-actions">
      <view class="secondary-btn" bindtap="goBack">回到总览</view>
      <view class="next-btn" bindtap="loadNext">继续练习</view>
    </view>
  </view>

  <view wx:elif="{{word}}" class="practice-shell">
    <view class="top-card">
      <view class="round-icon" bindtap="goBack">‹</view>
      <view class="book-meta">
        <view class="book-name">{{bookTitle}}</view>
        <view class="progress-line">{{headerSubtitle}}</view>
      </view>
      <view class="round-icon" bindtap="goToBooks">⋯</view>
    </view>

    <view class="progress-track">
      <view style="width: {{progressPercent}}%;"></view>
    </view>

    <view class="word-hero {{detailVisible ? 'compact dictionary-hero' : ''}}">
      <view class="word-main-row">
        <view class="word">{{word.word}}</view>
        <view wx:if="{{detailVisible && (word.audioUsUrl || word.audioUkUrl)}}" class="hero-audio" bindtap="playAudio" data-url="{{word.audioUsUrl || word.audioUkUrl}}">
          <image class="audio-icon" src="/images/icons/volume.svg" mode="aspectFit" />
        </view>
      </view>
      <view class="phonetic-row" wx:if="{{word.phonetic || word.audioUkUrl || word.audioUsUrl}}">
        <view class="pron-chip" wx:if="{{word.audioUsUrl}}" bindtap="playAudio" data-url="{{word.audioUsUrl}}">
          <text>美音</text>
          <image class="audio-icon" src="/images/icons/volume.svg" mode="aspectFit" />
        </view>
        <view class="pron-chip" wx:if="{{word.audioUkUrl}}" bindtap="playAudio" data-url="{{word.audioUkUrl}}">
          <text>英音</text>
          <image class="audio-icon" src="/images/icons/volume.svg" mode="aspectFit" />
        </view>
        <text wx:if="{{word.phonetic}}" class="phonetic">{{word.phonetic}}</text>
      </view>
      <view wx:if="{{detailVisible && (word.definitionZh || word.definitionEn)}}" class="meaning-lines">
        <view class="meaning-line" wx:if="{{word.definitionZh}}">
          <text wx:if="{{word.definitionZh}}" class="meaning-mark">{{word.definitionZh}}</text>
        </view>
        <view class="meaning-en" wx:if="{{word.definitionEn}}">{{word.definitionEn}}</view>
      </view>
      <view wx:if="{{!detailVisible}}" class="recall-tip">先在心里说出中文含义和一个使用场景，再选择记忆状态。</view>
    </view>

    <view class="recall-hints" wx:if="{{!detailVisible}}">
      <view class="hint-line"></view>
      <view class="hint-line short"></view>
      <view class="hint-line tiny"></view>
    </view>

    <view class="inline-detail dictionary-detail" wx:if="{{detailVisible}}">
      <view class="example-card" wx:if="{{word.exampleEn || word.exampleZh}}">
        <view wx:if="{{word.exampleAudioUsUrl || word.exampleAudioUkUrl}}" class="sentence-audio" bindtap="playAudio" data-url="{{word.exampleAudioUsUrl || word.exampleAudioUkUrl}}">
          <image class="audio-icon" src="/images/icons/volume.svg" mode="aspectFit" />
        </view>
        <view class="example-en" wx:if="{{word.exampleEn}}">{{word.exampleEn}}</view>
        <view class="example-zh" wx:if="{{word.exampleZh}}">{{word.exampleZh}}</view>
      </view>

      <view class="pattern-card" wx:if="{{word.commonPatterns || word.sourceScene || word.sourceTopicTitle}}">
        <view class="pattern-content" wx:if="{{word.commonPatterns}}">{{word.commonPatterns}}</view>
        <view class="source-line" wx:if="{{word.sourceScene || word.sourceTopicTitle}}">
          来源：{{word.sourceScene || word.sourceTopicTitle}}
        </view>
      </view>
    </view>

    <view class="answer-row" wx:if="{{!detailVisible}}">
      <view class="answer-btn known {{submitting ? 'disabled' : ''}}" bindtap="answer" data-result="KNOWN">
        <text>认识</text>
      </view>
      <view class="answer-btn fuzzy {{submitting ? 'disabled' : ''}}" bindtap="answer" data-result="FUZZY">
        <text>模糊</text>
      </view>
      <view class="answer-btn unknown {{submitting ? 'disabled' : ''}}" bindtap="answer" data-result="UNKNOWN">
        <text>不认识</text>
      </view>
    </view>

    <view class="next-area" wx:if="{{detailVisible}}">
      <view class="secondary-btn" bindtap="markFocus">加入重点复习</view>
      <view class="next-btn" bindtap="loadNext">下一词</view>
    </view>
  </view>
</view>
