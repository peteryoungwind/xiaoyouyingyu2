.practice-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 190rpx;
  background:
    linear-gradient(150deg, rgba(47, 111, 237, 0.12), transparent 34%),
    linear-gradient(25deg, rgba(34, 168, 118, 0.09), transparent 36%),
    linear-gradient(180deg, #FFFFFF 0%, #F6F8FB 52%, #EEF3F8 100%);
  box-sizing: border-box;
}

.detail-mode {
  padding-bottom: 210rpx;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #6E6E73;
}

.practice-shell {
  min-height: calc(100vh - 238rpx);
  display: flex;
  flex-direction: column;
}

.top-card {
  position: sticky;
  top: 0;
  z-index: 5;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 2rpx solid rgba(212, 219, 231, 0.9);
  box-shadow: 0 16rpx 38rpx rgba(28, 43, 74, 0.07);
}

.round-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
  color: #172033;
  border: 2rpx solid rgba(212, 219, 231, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
}

.book-meta {
  flex: 1;
  min-width: 0;
}

.book-name {
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 850;
  color: #172033;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.progress-line {
  margin-top: 8rpx;
  color: #667085;
  font-size: 22rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.progress-track {
  height: 12rpx;
  margin: 22rpx 0 28rpx;
  border-radius: 999rpx;
  background: rgba(226, 232, 240, 0.88);
  overflow: hidden;
}

.progress-track view {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #22A876, #2F6FED);
}

.word-hero {
  margin-top: 0;
  padding: 52rpx 28rpx 56rpx;
  border-radius: 38rpx;
  text-align: center;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.78)),
    linear-gradient(135deg, rgba(47, 111, 237, 0.12), rgba(34, 168, 118, 0.1));
  border: 2rpx solid rgba(212, 219, 231, 0.9);
  box-shadow: 0 18rpx 48rpx rgba(28, 43, 74, 0.09);
}

.word-hero.compact {
  padding-top: 44rpx;
  padding-bottom: 44rpx;
}

.word {
  margin-top: 48rpx;
  font-size: 106rpx;
  line-height: 1;
  font-weight: 800;
  color: #172033;
  word-break: break-word;
}

.word-hero.compact .word {
  margin-top: 34rpx;
}

.phonetic-row {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.pron-chip {
  min-width: 78rpx;
  height: 54rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #EAF1FF;
  color: #1646A5;
  font-size: 25rpx;
  font-weight: 850;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  box-sizing: border-box;
}

.answer-btn::after,
.next-btn::after,
.secondary-btn::after {
  border: none;
}

.audio-icon {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.phonetic {
  font-size: 28rpx;
  line-height: 1.2;
  color: #667085;
}

.review-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #EAF1FF;
  color: #1646A5;
  font-size: 23rpx;
  font-weight: 850;
}

.review-chip.fuzzy-chip {
  color: #9B6812;
  background: #FFF6DF;
}

.review-chip.unknown-chip {
  color: #B7473D;
  background: #FFF0ED;
}

.review-chip.known-chip {
  color: #13795B;
  background: #E9F8F1;
}

.recall-tip {
  width: 86%;
  margin: 28rpx auto 0;
  color: #667085;
  font-size: 26rpx;
  line-height: 1.55;
}

.recall-hints {
  display: grid;
  gap: 18rpx;
  width: 72%;
  margin: 54rpx auto 0;
}

.hint-line {
  height: 14rpx;
  border-radius: 999rpx;
  background: #E9E9EF;
}

.hint-line.short {
  width: 66%;
  margin: 0 auto;
}

.hint-line.tiny {
  width: 42%;
  margin: 0 auto;
}

.inline-detail {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(212, 219, 231, 0.9);
  box-shadow: 0 12rpx 34rpx rgba(28, 43, 74, 0.07);
}

.eyebrow {
  color: #667085;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 850;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.definition-block {
  margin-top: 18rpx;
  font-size: 34rpx;
  line-height: 1.55;
  color: #1D1D1F;
  word-break: break-word;
}

.pos {
  display: inline-flex;
  margin-right: 14rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EAF1FF;
  color: #1646A5;
  font-size: 24rpx;
  font-weight: 850;
}

.definition-text {
  font-weight: 750;
}

.definition-en {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #667085;
}

.example-card,
.pattern-card {
  margin-top: 22rpx;
  border-radius: 26rpx;
  background: rgba(246, 248, 251, 0.94);
}

.example-card {
  padding: 24rpx;
}

.example-sentence {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  font-size: 30rpx;
  line-height: 1.45;
  color: #172033;
  word-break: break-word;
}

.sentence-audio {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2F6FED, #7464FF);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sentence-audio .audio-icon {
  width: 28rpx;
  height: 28rpx;
  filter: brightness(0) invert(1);
}

.example-en {
  flex: 1;
  min-width: 0;
  font-weight: 800;
}

.example-zh {
  margin-top: 14rpx;
  padding-left: 76rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #6E6E73;
}

.pattern-card {
  padding: 24rpx;
}

.pattern-content {
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #1D1D1F;
  white-space: pre-wrap;
}

.source-line {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #8E8E93;
}

.answer-row {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18rpx;
  z-index: 10;
}

.answer-btn,
.next-btn {
  height: 86rpx;
  padding: 0;
  margin: 0;
  border-radius: 28rpx;
  font-size: 30rpx;
  line-height: 1;
  font-weight: 850;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.answer-btn.disabled {
  opacity: 0.55;
  pointer-events: none;
}

.answer-btn.known {
  color: #13795B;
  background: #E9F8F1;
}

.answer-btn.fuzzy {
  color: #9A6A00;
  background: #FFF8E8;
}

.answer-btn.unknown {
  color: #D23B31;
  background: #FFF2F1;
}

.next-area {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 10;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.next-btn {
  width: 100%;
  background: linear-gradient(135deg, #2F6FED, #7464FF);
  color: #FFFFFF;
}

.secondary-btn {
  margin-top: 0;
  height: 82rpx;
  border-radius: 26rpx;
  background: #EAF1FF;
  color: #1646A5;
  font-size: 28rpx;
  font-weight: 850;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.review-page {
  min-height: calc(100vh - 238rpx);
}

.review-header {
  display: grid;
  grid-template-columns: 62rpx 1fr 62rpx;
  align-items: center;
  gap: 20rpx;
}

.review-title-wrap {
  text-align: center;
}

.review-title {
  margin-top: 8rpx;
  color: #172033;
  font-size: 48rpx;
  line-height: 1.1;
  font-weight: 900;
}

.result-card {
  margin-top: 26rpx;
  padding: 32rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(212, 219, 231, 0.9);
  box-shadow: 0 14rpx 36rpx rgba(28, 43, 74, 0.08);
}

.result-title {
  margin-top: 10rpx;
  color: #172033;
  font-size: 36rpx;
  line-height: 1.25;
  font-weight: 900;
}

.result-desc {
  margin-top: 12rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.55;
}

.score-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 24rpx;
}

.score-row view {
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(246, 248, 251, 0.94);
}

.score-row text:first-child {
  display: block;
  color: #172033;
  font-size: 42rpx;
  font-weight: 900;
}

.score-row text:last-child {
  display: block;
  margin-top: 8rpx;
  color: #667085;
  font-size: 22rpx;
}

.card-row,
.book-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.section-title {
  margin-top: 8rpx;
  color: #172033;
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 900;
}

.text-action {
  color: #2F6FED;
  font-size: 26rpx;
  font-weight: 850;
}

.book-summary {
  margin-top: 22rpx;
  padding: 26rpx;
  border-radius: 26rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(212, 219, 231, 0.9);
}

.book-summary-name {
  color: #172033;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 900;
}

.book-summary-desc {
  margin-top: 10rpx;
  color: #667085;
  font-size: 23rpx;
}

.active-mark {
  color: #22A876;
  font-size: 34rpx;
  font-weight: 900;
}

.review-actions {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  z-index: 10;
}
