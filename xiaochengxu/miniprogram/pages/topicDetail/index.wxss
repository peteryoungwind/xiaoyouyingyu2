.info-card { padding: 32rpx; }
.info-title { font-size: 36rpx; font-weight: 700; line-height: 1.4; }
.info-title-zh { font-size: 28rpx; color: var(--text-secondary); margin-top: 12rpx; }
.info-meta { margin-top: 20rpx; }
.info-date { font-size: 24rpx; color: var(--text-hint); }
.info-tags { margin-top: 16rpx; display: flex; flex-wrap: wrap; }

.questions-card { padding: 32rpx; }
.question-item { display: flex; padding: 20rpx 0; border-bottom: 1rpx solid var(--border); }
.question-item:last-child { border-bottom: none; }
.question-number {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: var(--primary-light); color: var(--primary);
  font-size: 24rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-right: 20rpx; margin-top: 4rpx;
}
.question-content { flex: 1; }
.question-en { font-size: 28rpx; line-height: 1.5; }
.question-zh { font-size: 24rpx; color: var(--text-secondary); margin-top: 8rpx; }

.action-bar { padding: 24rpx 0; }
.loading-wrap { text-align: center; padding: 120rpx 0; }
.loading-text { color: var(--text-hint); font-size: 28rpx; }
.empty-text { text-align: center; color: var(--text-hint); padding: 32rpx; }
