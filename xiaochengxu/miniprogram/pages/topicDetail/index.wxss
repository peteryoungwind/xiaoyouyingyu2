.info-card { padding: 32rpx; }
.info-title { font-size: 36rpx; font-weight: 600; line-height: 1.4; }
.info-title-zh { font-size: 28rpx; color: #6C7A8D; margin-top: 12rpx; }
.info-meta { margin-top: 20rpx; }
.info-date { font-size: 24rpx; color: #B0B8C4; }
.info-tags { margin-top: 16rpx; display: flex; flex-wrap: wrap; }

.questions-card { padding: 32rpx; }
.question-item { display: flex; padding: 20rpx 0; border-bottom: 1rpx solid #F0F2F5; }
.question-item:last-child { border-bottom: none; }
.question-number { width: 48rpx; height: 48rpx; border-radius: 50%; background: #E8F0FE; color: #4A90D9; font-size: 24rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-right: 20rpx; margin-top: 4rpx; }
.question-content { flex: 1; }
.question-en { font-size: 28rpx; line-height: 1.5; }
.question-zh { font-size: 24rpx; color: #6C7A8D; margin-top: 8rpx; }

.action-bar { padding: 24rpx 0; }
.loading-wrap { text-align: center; padding: 120rpx 0; }
.loading-text { color: #B0B8C4; font-size: 28rpx; }
.empty-text { text-align: center; color: #B0B8C4; padding: 32rpx; }
