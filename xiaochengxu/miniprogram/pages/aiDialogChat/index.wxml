<view class="chat-page safe-bottom">
  <view class="top-card">
    <view class="round-icon" bindtap="goBack">‹</view>
    <view class="topic-meta">
      <view class="topic-name">{{customTopic || topicTitleZh || topicTitle || 'AI 对话练习'}}</view>
      <view class="meta-line">
        <view class="meta-pill">{{mode === 'TEACHING' ? '教学模式' : '练习模式'}}</view>
        <view class="meta-pill">{{difficulty === 'BEGINNER' ? '初级' : '进阶'}}</view>
        <view class="meta-pill">剩余 {{remainingToday}}</view>
        <view class="meta-pill">{{roundCount}}/{{config.maxRoundsPerSession || '-'}}</view>
      </view>
      <view class="progress-track">
        <view class="progress-fill" style="width: {{progressPercent}}%;"></view>
      </view>
    </view>
    <view class="round-icon" bindtap="restart">↻</view>
  </view>

  <view wx:if="{{error}}" class="error-box">{{error}}</view>

  <scroll-view class="message-list" scroll-y="true">
    <view wx:if="{{messages.length === 0}}" class="empty-chat">
      <view class="empty-title">说第一句吧</view>
      <view class="empty-desc">可以用英文，也可以先中英混合表达。AI 会接住你的表达，再帮你变自然。</view>
      <view class="prompt-chips">
        <view wx:for="{{promptChips}}" wx:key="text" class="prompt-chip" bindtap="usePrompt" data-text="{{item.text}}">{{item.text}}</view>
      </view>
    </view>

    <view wx:for="{{messages}}" wx:key="id" class="message-row {{item.role === 'user' ? 'user-row' : 'assistant-row'}}">
      <view class="bubble {{item.role === 'user' ? 'user-bubble' : 'assistant-bubble'}}">
        <block wx:if="{{item.thinking}}">
          <view class="thinking">
            <view class="dot"></view>
            <view class="dot"></view>
            <view class="dot"></view>
            <text>AI 思考中</text>
          </view>
        </block>
        <block wx:elif="{{item.role === 'user'}}">
          <view class="message-text">{{item.content}}</view>
        </block>
        <block wx:else>
          <view class="assistant-actions">
            <view wx:if="{{item.audioUrl}}" class="audio-pill" bindtap="replayAudio" data-id="{{item.id}}">
              <view class="audio-bars">
                <view></view><view></view><view></view><view></view>
              </view>
              <text>播放</text>
            </view>
            <view class="text-toggle" bindtap="toggleText" data-id="{{item.id}}">{{item.showText ? '隐藏文字' : '显示文字'}}</view>
          </view>
          <view wx:if="{{item.showText}}" class="message-text english">{{item.reply.replyEn}}</view>
          <view wx:if="{{item.showText && item.reply.nextPromptEn}}" class="next-prompt">{{item.reply.nextPromptEn}}</view>
          <view wx:if="{{mode === 'TEACHING' && item.reply.feedbackZh}}" class="feedback">
            <view class="feedback-title">教学点评</view>
            <view>{{item.reply.feedbackZh}}</view>
            <view wx:if="{{item.reply.betterExpressionEn}}" class="better">“{{item.reply.betterExpressionEn}}”</view>
            <view wx:if="{{item.reply.betterExpressionZh}}" class="better-zh">{{item.reply.betterExpressionZh}}</view>
          </view>
        </block>
      </view>
    </view>
  </scroll-view>

  <view class="input-bar">
    <view class="composer-shell">
      <view class="mode-toggle" bindtap="toggleInputMode">
        <block wx:if="{{inputMode === 'voice'}}">
          <view class="keyboard-icon">
            <view></view><view></view><view></view>
            <view></view><view></view><view></view>
            <view></view>
          </view>
        </block>
        <block wx:else>
          <view class="voice-icon">
            <view></view><view></view><view></view>
          </view>
        </block>
      </view>

      <textarea wx:if="{{inputMode === 'text'}}" class="input" value="{{inputText}}" bindinput="onInput" auto-height maxlength="1000" placeholder="输入你想说的话..." placeholder-class="placeholder" />
      <view wx:else class="voice-input {{recording ? 'recording' : ''}}" bindtouchstart="startRecord" bindtouchend="stopRecord" bindtouchcancel="stopRecord">{{transcribing ? '识别中...' : (recording ? '松开结束' : '按住说话')}}</view>

      <view class="send-btn {{!inputText || sending ? 'disabled' : ''}}" bindtap="sendMessage">{{sending ? '…' : '↑'}}</view>
    </view>
    <view wx:if="{{roundCount >= config.maxRoundsPerSession}}" class="limit-line">本次练习已完成，可以重新开始。</view>
    <view wx:if="{{remainingToday <= 0}}" class="limit-line">今日额度已用尽，明天再来练习。</view>
    <view class="restart" bindtap="restart">重新选择主题</view>
  </view>
</view>
