<view class="page-container safe-bottom">
  <view class="page-title">选择单词本</view>
  <view class="page-subtitle">到期复习优先，新词随后出现。</view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:elif="{{books.length > 0}}" class="book-list">
    <view wx:for="{{books}}" wx:key="id" class="book-card" bindtap="goToBook" data-id="{{item.id}}">
      <view class="book-header">
        <view>
          <view class="book-name">{{item.name}}</view>
          <view class="book-desc">{{item.description || item.scene || '暂无描述'}}</view>
        </view>
        <view class="book-arrow">›</view>
      </view>
      <view class="book-stats">
        <view class="stat"><text>{{item.stats.beginnerWords || 0}}</text><text>初级词</text></view>
        <view class="stat"><text>{{item.stats.advancedWords || 0}}</text><text>进阶词</text></view>
        <view class="stat"><text>{{item.progress.learned || 0}}</text><text>已学</text></view>
        <view class="stat"><text>{{item.progress.mastered || 0}}</text><text>掌握</text></view>
      </view>
    </view>
  </view>

  <view wx:else class="empty">
    <view class="empty-title">暂无已发布单词本</view>
    <view class="empty-desc">稍后再来看看</view>
  </view>
</view>
