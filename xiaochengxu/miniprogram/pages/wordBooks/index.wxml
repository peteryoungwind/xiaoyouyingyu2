<view class="word-books-page safe-bottom">
  <view class="page-hero">
    <view>
      <view class="eyebrow">Word Practice</view>
      <view class="page-title">选择单词本</view>
      <view class="page-desc">按当前阶段选择词书，系统会记住你的最近选择。</view>
    </view>
  </view>

  <view class="summary-strip" wx:if="{{books.length > 0}}">
    <view class="summary-card">
      <text>今日待复习</text>
      <view>{{totalDueReview}}</view>
    </view>
    <view class="summary-card">
      <text>已掌握</text>
      <view>{{totalMastered}}</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:elif="{{books.length > 0}}" class="level-list">
    <view class="level-section beginner">
      <view class="section-heading">
        <view>
          <view class="section-kicker">Beginner</view>
          <view class="section-title">初级词书</view>
        </view>
        <view class="section-count">{{beginnerBooks.length}} 本</view>
      </view>

      <view wx:if="{{beginnerBooks.length > 0}}" class="book-grid">
        <view wx:for="{{beginnerBooks}}" wx:key="id" class="book-card" bindtap="goToBook" data-id="{{item.id}}" data-level="{{item.level}}">
          <view class="book-cover {{item.cover.className}}">
            <view class="cover-wave"></view>
            <view class="cover-shape shape-sun"></view>
            <view class="cover-icon {{item.cover.iconClass}}">
              <view></view>
              <view></view>
              <view></view>
            </view>
            <view class="cover-mark">{{item.levelLabel}}</view>
            <view class="cover-title">{{item.cover.title}}</view>
            <view class="cover-subtitle">{{item.cover.subtitle}}</view>
            <view class="cover-hint">{{item.cover.hint}}</view>
          </view>
          <view class="book-info">
            <view class="book-name">{{item.name}}</view>
            <view class="book-meta">{{item.wordCount || 0}} 词 · {{item.statusText}}</view>
          </view>
        </view>
      </view>
      <view wx:else class="section-empty">暂无初级词书</view>
    </view>

    <view class="level-section advanced">
      <view class="section-heading">
        <view>
          <view class="section-kicker">Advanced</view>
          <view class="section-title">进阶词书</view>
        </view>
        <view class="section-count">{{advancedBooks.length}} 本</view>
      </view>

      <view wx:if="{{advancedBooks.length > 0}}" class="book-grid">
        <view wx:for="{{advancedBooks}}" wx:key="id" class="book-card" bindtap="goToBook" data-id="{{item.id}}" data-level="{{item.level}}">
          <view class="book-cover {{item.cover.className}}">
            <view class="cover-wave"></view>
            <view class="cover-shape shape-sun"></view>
            <view class="cover-icon {{item.cover.iconClass}}">
              <view></view>
              <view></view>
              <view></view>
            </view>
            <view class="cover-mark">{{item.levelLabel}}</view>
            <view class="cover-title">{{item.cover.title}}</view>
            <view class="cover-subtitle">{{item.cover.subtitle}}</view>
            <view class="cover-hint">{{item.cover.hint}}</view>
          </view>
          <view class="book-info">
            <view class="book-name">{{item.name}}</view>
            <view class="book-meta">{{item.wordCount || 0}} 词 · {{item.statusText}}</view>
          </view>
        </view>
      </view>
      <view wx:else class="section-empty">暂无进阶词书</view>
    </view>
  </view>

  <view wx:else class="empty">
    <view class="empty-title">暂无已发布单词本</view>
  </view>
</view>
