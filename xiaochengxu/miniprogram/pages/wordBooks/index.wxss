.word-books-page {
  min-height: 100vh;
  padding: 36rpx 28rpx 48rpx;
  background:
    linear-gradient(150deg, rgba(47, 111, 237, 0.12), transparent 34%),
    linear-gradient(25deg, rgba(34, 168, 118, 0.09), transparent 36%),
    linear-gradient(180deg, #FFFFFF 0%, #F6F8FB 52%, #EEF3F8 100%);
  box-sizing: border-box;
}
.page-hero { padding-bottom: 24rpx; }
.eyebrow {
  color: #2F6FED;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 850;
  letter-spacing: 1.6rpx;
  text-transform: uppercase;
}
.page-title { margin-top: 10rpx; font-size: 50rpx; line-height: 1.15; font-weight: 900; color: #172033; }
.page-desc { margin-top: 12rpx; color: #667085; font-size: 25rpx; line-height: 1.55; }
.summary-strip { display: flex; gap: 18rpx; margin: 4rpx 0 22rpx; }
.summary-card {
  flex: 1;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 2rpx solid rgba(212, 219, 231, 0.82);
}
.summary-card text { color: #667085; font-size: 22rpx; }
.summary-card view { margin-top: 6rpx; color: #172033; font-size: 34rpx; font-weight: 900; }
.loading, .empty { padding: 120rpx 20rpx; text-align: center; color: #667085; font-size: 28rpx; }
.empty-title { font-size: 32rpx; font-weight: 800; color: #172033; }
.book-list { display: flex; flex-direction: column; gap: 20rpx; }
.book-card {
  padding: 30rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(212, 219, 231, 0.9);
  box-shadow: 0 14rpx 36rpx rgba(28, 43, 74, 0.08);
}
.book-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.book-name { font-size: 34rpx; font-weight: 900; color: #172033; }
.book-desc { margin-top: 10rpx; font-size: 24rpx; line-height: 1.5; color: #667085; }
.book-arrow {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #EAF1FF;
  color: #1646A5;
  font-size: 42rpx;
  line-height: 48rpx;
  text-align: center;
}
.progress-track {
  height: 12rpx;
  margin: 28rpx 0 22rpx;
  border-radius: 999rpx;
  background: rgba(226, 232, 240, 0.88);
  overflow: hidden;
}
.progress-track view { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #22A876, #2F6FED); }
.metric-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14rpx; }
.metric-grid view { min-width: 0; }
.metric-grid text:first-child { display: block; font-size: 30rpx; font-weight: 900; color: #172033; }
.metric-grid text:last-child { display: block; margin-top: 4rpx; font-size: 21rpx; color: #667085; }
