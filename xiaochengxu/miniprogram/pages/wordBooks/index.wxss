.word-books-page {
  min-height: 100vh;
  padding: 36rpx 28rpx 48rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #F5F7FA 46%, #EEF2F7 100%);
  box-sizing: border-box;
}
.page-hero { padding-bottom: 22rpx; }
.page-title { font-size: 46rpx; line-height: 1.15; font-weight: 850; color: #1D1D1F; }
.summary-strip { display: flex; gap: 18rpx; margin: 4rpx 0 22rpx; }
.summary-card {
  flex: 1;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.74);
  border: 2rpx solid #F0F0F4;
}
.summary-card text { color: #8E8E93; font-size: 22rpx; }
.summary-card view { margin-top: 6rpx; color: #1D1D1F; font-size: 34rpx; font-weight: 850; }
.loading, .empty { padding: 120rpx 20rpx; text-align: center; color: #8E8E93; font-size: 28rpx; }
.empty-title { font-size: 32rpx; font-weight: 700; color: #1D1D1F; }
.book-list { display: flex; flex-direction: column; gap: 20rpx; }
.book-card {
  padding: 30rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(229, 229, 234, 0.78);
  box-shadow: 0 8rpx 24rpx rgba(17, 24, 39, 0.04);
}
.book-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.book-name { font-size: 34rpx; font-weight: 800; color: #1D1D1F; }
.book-desc { margin-top: 10rpx; font-size: 24rpx; line-height: 1.5; color: #6E6E73; }
.book-arrow {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #F2F2F7;
  color: #8E8E93;
  font-size: 42rpx;
  line-height: 48rpx;
  text-align: center;
}
.progress-track {
  height: 12rpx;
  margin: 28rpx 0 22rpx;
  border-radius: 999rpx;
  background: #F2F2F7;
  overflow: hidden;
}
.progress-track view { height: 100%; border-radius: 999rpx; background: #007AFF; }
.metric-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14rpx; }
.metric-grid view { min-width: 0; }
.metric-grid text:first-child { display: block; font-size: 30rpx; font-weight: 850; color: #1D1D1F; }
.metric-grid text:last-child { display: block; margin-top: 4rpx; font-size: 21rpx; color: #8E8E93; }
