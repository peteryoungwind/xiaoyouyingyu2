.status-card {
  margin-bottom: 24rpx;
}

.status-title {
  color: #8E8E93;
  font-size: 26rpx;
}

.status-value {
  margin-top: 12rpx;
  color: #111827;
  font-size: 34rpx;
  font-weight: 700;
}

.status-value.muted {
  color: #8E8E93;
}

.plans {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.plan-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.06);
}

.plan-main,
.plan-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.plan-name {
  color: #111827;
  font-size: 34rpx;
  font-weight: 700;
}

.plan-desc {
  margin-top: 8rpx;
  color: #8E8E93;
  font-size: 24rpx;
}

.plan-duration {
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #E5F1FF;
  color: #007AFF;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
}

.plan-bottom {
  margin-top: 28rpx;
}

.price {
  color: #FF9500;
  font-size: 44rpx;
  font-weight: 800;
}

.price-unit {
  font-size: 24rpx;
  margin-right: 4rpx;
}

.origin-price {
  margin-left: 12rpx;
  color: #C7C7CC;
  font-size: 24rpx;
  font-weight: 400;
  text-decoration: line-through;
}

.buy-btn {
  margin: 0;
  border-radius: 999rpx;
  background: #007AFF;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  padding: 0 28rpx;
}

.confirming {
  margin-top: 24rpx;
  text-align: center;
  color: #8E8E93;
  font-size: 24rpx;
}
