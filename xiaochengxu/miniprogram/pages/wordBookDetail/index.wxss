.word-book-detail-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 52rpx;
  background:
    linear-gradient(150deg, rgba(47, 111, 237, 0.12), transparent 34%),
    linear-gradient(25deg, rgba(34, 168, 118, 0.09), transparent 36%),
    linear-gradient(180deg, #FFFFFF 0%, #F6F8FB 52%, #EEF3F8 100%);
  box-sizing: border-box;
}
.loading { padding: 120rpx 0; text-align: center; color: #8E8E93; }
.top-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(212, 219, 231, 0.9);
  box-shadow: 0 16rpx 38rpx rgba(28, 43, 74, 0.07);
}
.round-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
  color: #172033;
  border: 2rpx solid rgba(212, 219, 231, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
}
.book-meta { flex: 1; min-width: 0; }
.book-name { font-size: 30rpx; line-height: 1.35; font-weight: 850; color: #172033; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.book-desc { margin-top: 8rpx; font-size: 22rpx; line-height: 1.35; color: #667085; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hub-hero {
  margin-top: 22rpx;
  padding: 34rpx 30rpx 30rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #EAF1FF 62%, #FFF5EA 100%);
  border: 2rpx solid rgba(47, 111, 237, 0.18);
  box-shadow: 0 18rpx 48rpx rgba(28, 43, 74, 0.09);
}
.hub-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}
.hub-copy {
  flex: 1;
  min-width: 0;
}
.eyebrow {
  color: #2F6FED;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 850;
  letter-spacing: 1.6rpx;
  text-transform: uppercase;
}
.hub-title {
  margin-top: 12rpx;
  color: #172033;
  font-size: 50rpx;
  line-height: 1.12;
  font-weight: 900;
  word-break: break-word;
}
.hub-desc {
  margin-top: 14rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.55;
}
.progress-badge {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #FFFFFF 0 55%, transparent 56%), conic-gradient(#22A876 0 64%, #E7EDF5 64% 100%);
  color: #22A876;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.progress-badge text {
  font-size: 32rpx;
  line-height: 1;
  font-weight: 900;
}
.progress-badge view {
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 750;
}
.mode-row {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
.start-btn {
  width: 100%;
  height: 88rpx;
  margin: 28rpx 0 0;
  padding: 0;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #2F6FED, #7464FF);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 36rpx rgba(47, 111, 237, 0.25);
}
.start-btn::after {
  border: none;
}
.segmented {
  flex: 1;
  display: flex;
  gap: 8rpx;
  padding: 7rpx;
  border: 2rpx solid rgba(212, 219, 231, 0.9);
  border-radius: 24rpx;
  background: rgba(238, 243, 248, 0.8);
}
.segment { flex: 1; min-height: 62rpx; border-radius: 17rpx; display: flex; align-items: center; justify-content: center; font-size: 25rpx; font-weight: 800; color: #667085; }
.segment.active { background: #FFFFFF; color: #1646A5; box-shadow: inset 0 0 0 2rpx rgba(47, 111, 237, 0.12); }
.switch-book-btn {
  min-width: 142rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #EAF1FF;
  color: #1646A5;
  font-size: 25rpx;
  font-weight: 850;
  display: flex;
  align-items: center;
  justify-content: center;
}
.quick-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 22rpx;
}
.quick-stats view {
  min-width: 0;
  padding: 24rpx 18rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 2rpx solid rgba(212, 219, 231, 0.82);
}
.quick-stats text:first-child {
  display: block;
  color: #172033;
  font-size: 38rpx;
  line-height: 1;
  font-weight: 900;
}
.quick-stats text:last-child {
  display: block;
  margin-top: 10rpx;
  color: #667085;
  font-size: 21rpx;
}
.plan-card {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(212, 219, 231, 0.9);
  box-shadow: 0 12rpx 34rpx rgba(28, 43, 74, 0.07);
}
.section-title {
  margin-top: 8rpx;
  color: #172033;
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 900;
}
.task-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 22rpx;
}
.task-row {
  display: grid;
  grid-template-columns: 76rpx 1fr 28rpx;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(246, 248, 251, 0.9);
}
.task-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
}
.task-icon.review {
  color: #1646A5;
  background: #EAF1FF;
}
.task-icon.new {
  color: #13795B;
  background: #E9F8F1;
}
.task-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 850;
}
.task-desc {
  margin-top: 6rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.35;
}
.task-arrow {
  color: #98A2B3;
  font-size: 34rpx;
  font-weight: 850;
}
.progress-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; margin-top: 20rpx; }
.progress-card { background: rgba(255, 255, 255, 0.74); border: 2rpx solid rgba(212, 219, 231, 0.72); border-radius: 26rpx; padding: 28rpx; }
.progress-card text:first-child { display: block; font-size: 42rpx; font-weight: 850; color: #172033; }
.progress-card text:last-child { display: block; margin-top: 8rpx; font-size: 23rpx; color: #667085; }
