.word-book-detail-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #F5F7FA 46%, #EEF2F7 100%);
  box-sizing: border-box;
}
.loading { padding: 120rpx 0; text-align: center; color: #8E8E93; }
.top-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid #ECECF0;
  box-shadow: 0 12rpx 30rpx rgba(17, 24, 39, 0.04);
}
.round-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #F2F2F7;
  color: #1D1D1F;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
}
.book-meta { flex: 1; min-width: 0; }
.book-name { font-size: 30rpx; line-height: 1.35; font-weight: 850; color: #1D1D1F; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.book-desc { margin-top: 8rpx; font-size: 22rpx; line-height: 1.35; color: #6E6E73; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.study-hero {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(229, 229, 234, 0.78);
  box-shadow: 0 8rpx 24rpx rgba(17, 24, 39, 0.04);
}
.start-btn {
  width: 100%;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border-radius: 28rpx;
  background: #007AFF;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 34rpx rgba(0, 122, 255, 0.22);
}
.start-btn::after {
  border: none;
}
.control-card {
  margin-top: 20rpx;
  padding: 14rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(229, 229, 234, 0.78);
}
.segmented { display: flex; gap: 8rpx; padding: 6rpx; border: 2rpx solid rgba(229, 229, 234, 0.9); border-radius: 22rpx; background: rgba(242, 242, 247, 0.62); }
.segment { flex: 1; min-height: 60rpx; border-radius: 17rpx; display: flex; align-items: center; justify-content: center; font-size: 25rpx; font-weight: 700; color: #6E6E73; }
.segment.active { background: rgba(255, 255, 255, 0.84); color: #007AFF; box-shadow: inset 0 0 0 2rpx rgba(0, 122, 255, 0.12); }
.progress-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; margin-top: 20rpx; }
.progress-card { background: rgba(255, 255, 255, 0.74); border: 2rpx solid #F0F0F4; border-radius: 26rpx; padding: 28rpx; }
.progress-card text:first-child { display: block; font-size: 42rpx; font-weight: 850; color: #1D1D1F; }
.progress-card text:last-child { display: block; margin-top: 8rpx; font-size: 23rpx; color: #8E8E93; }
