<view class="page-container safe-bottom">
  <view wx:if="{{loading}}" class="loading">加载中...</view>
  <view wx:elif="{{book}}">
    <view class="book-hero">
      <view class="book-name">{{book.name}}</view>
      <view class="book-desc">{{book.description || book.scene || '暂无描述'}}</view>
    </view>

    <view class="segmented">
      <view class="segment {{difficulty === 'BEGINNER' ? 'active' : ''}}" bindtap="switchDifficulty" data-difficulty="BEGINNER">初级</view>
      <view class="segment {{difficulty === 'ADVANCED' ? 'active' : ''}}" bindtap="switchDifficulty" data-difficulty="ADVANCED">进阶</view>
    </view>

    <view class="progress-grid">
      <view class="progress-card"><text>{{book.progress.total || 0}}</text><text>总词数</text></view>
      <view class="progress-card"><text>{{book.progress.learned || 0}}</text><text>已学</text></view>
      <view class="progress-card"><text>{{book.progress.dueReview || 0}}</text><text>待复习</text></view>
      <view class="progress-card"><text>{{book.progress.mastered || 0}}</text><text>已掌握</text></view>
    </view>

    <button class="start-btn" bindtap="startPractice">开始练习</button>

    <view class="word-section">
      <view class="word-section-header">
        <view class="word-section-title">学习记录</view>
        <view class="word-filter">
          <view class="filter-item {{wordFilter === 'ALL' ? 'active' : ''}}" bindtap="switchWordFilter" data-filter="ALL">已学</view>
          <view class="filter-item {{wordFilter === 'MASTERED' ? 'active' : ''}}" bindtap="switchWordFilter" data-filter="MASTERED">已掌握</view>
        </view>
      </view>

      <view wx:if="{{learnedWords.length > 0}}" class="learned-list">
        <block wx:for="{{learnedWords}}" wx:key="id">
          <view
            wx:if="{{wordFilter === 'ALL' || item.progress.status === 'MASTERED'}}"
            class="learned-card"
            bindtap="goToWordDetail"
            data-id="{{item.id}}"
          >
            <view>
              <view class="learned-word">{{item.word}}</view>
              <view class="learned-meaning">{{item.definitionZh}}</view>
            </view>
            <view class="learned-status {{item.progress.status === 'MASTERED' ? 'mastered' : ''}}">
              {{item.progress.status === 'MASTERED' ? '已掌握' : '学习中'}}
            </view>
          </view>
        </block>
      </view>

      <view wx:else class="word-empty">还没有学习记录</view>
    </view>
  </view>
</view>
