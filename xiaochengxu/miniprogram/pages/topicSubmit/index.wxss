.topic-submit-page {
  background: #F5F5F7;
}

.submit-header {
  margin-bottom: 28rpx;
}

.submit-title {
  font-size: 48rpx;
  line-height: 1.18;
  font-weight: 850;
  color: #1D1D1F;
}

.submit-subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #6E6E73;
}

.form-card {
  padding: 30rpx;
  border-radius: 34rpx;
  background: #FFFFFF;
  border: 2rpx solid #E5E5EA;
  box-shadow: 0 16rpx 40rpx rgba(17, 24, 39, 0.04);
}

.field {
  margin-bottom: 32rpx;
}

.field-label {
  margin-bottom: 14rpx;
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 800;
  color: #1D1D1F;
}

.required {
  color: #EF4444;
}

.field-input,
.field-textarea {
  width: 100%;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #F8FAFC;
  border: 2rpx solid #EEF0F4;
  color: #1D1D1F;
  font-size: 28rpx;
}

.field-input {
  height: 92rpx;
  padding: 0 24rpx;
}

.field-textarea {
  min-height: 190rpx;
  padding: 24rpx;
  line-height: 1.55;
}

.field-textarea.short {
  min-height: 140rpx;
}

.field-placeholder {
  color: #A1A1AA;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-chip {
  min-height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #F4F8FF;
  border: 2rpx solid #D8E8FF;
  color: #007AFF;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-chip.active {
  background: #007AFF;
  border-color: #007AFF;
  color: #FFFFFF;
}

.submit-button {
  width: 100%;
  height: 92rpx;
  padding: 0;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: #007AFF;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-button[disabled] {
  opacity: 0.7;
}

.submit-button::after {
  border: none;
}

.success-card {
  margin-top: 120rpx;
  padding: 44rpx 34rpx;
  border-radius: 36rpx;
  background: #EAF8F0;
  border: 2rpx solid rgba(31, 157, 102, 0.18);
  text-align: center;
}

.success-icon {
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto 28rpx;
  border-radius: 34rpx;
  background: #1F9D66;
  color: #FFFFFF;
  font-size: 56rpx;
  line-height: 104rpx;
  font-weight: 900;
}

.success-title {
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 850;
  color: #1D1D1F;
}

.success-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #4D4D52;
}

.success-actions {
  margin-top: 34rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.success-button {
  height: 82rpx;
  padding: 0;
  box-sizing: border-box;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-button::after {
  border: none;
}

.success-button.primary {
  background: #007AFF;
  color: #FFFFFF;
}

.success-button.secondary {
  background: #FFFFFF;
  color: #1D1D1F;
  border: 2rpx solid #E5E5EA;
}
