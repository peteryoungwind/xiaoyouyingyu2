<view class="page-container safe-bottom">
  <view wx:if="{{loading}}" class="loading">加载中...</view>
  <view wx:elif="{{word}}" class="detail-card">
    <view class="word-title">{{word.word}}</view>
    <view class="word-meta">
      <text wx:if="{{word.phonetic}}">{{word.phonetic}}</text>
      <text wx:if="{{word.partOfSpeech}}">{{word.partOfSpeech}}</text>
      <text>{{word.difficulty}}</text>
    </view>
    <view class="audio-row">
      <button bindtap="playAudio" data-url="{{word.audioUsUrl}}">单词美式</button>
      <button bindtap="playAudio" data-url="{{word.audioUkUrl}}">单词英式</button>
    </view>

    <view class="section">
      <view class="label">中文释义</view>
      <view class="text">{{word.definitionZh}}</view>
    </view>
    <view class="section">
      <view class="label">英文释义</view>
      <view class="text">{{word.definitionEn}}</view>
    </view>
    <view class="section" wx:if="{{word.commonPatterns}}">
      <view class="label">常用搭配/句型</view>
      <view class="text">{{word.commonPatterns}}</view>
    </view>
    <view class="section" wx:if="{{word.exampleEn || word.exampleZh}}">
      <view class="label">例句</view>
      <view class="text strong">{{word.exampleEn}}</view>
      <view class="text zh">{{word.exampleZh}}</view>
      <view class="audio-row small">
        <button bindtap="playAudio" data-url="{{word.exampleAudioUsUrl}}">例句美式</button>
        <button bindtap="playAudio" data-url="{{word.exampleAudioUkUrl}}">例句英式</button>
      </view>
    </view>
    <view class="section" wx:if="{{word.sourceScene || word.sourceTopicTitle}}">
      <view class="label">来源</view>
      <view class="text">{{word.sourceScene || word.sourceTopicTitle}}</view>
    </view>
  </view>
</view>
