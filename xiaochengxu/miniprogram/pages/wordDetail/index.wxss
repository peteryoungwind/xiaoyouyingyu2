.word-detail-page {
  min-height: 100vh;
  padding: 64rpx 52rpx calc(48rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 24% 8%, rgba(255, 255, 255, 0.72), transparent 26%),
    linear-gradient(180deg, #EEF6FF 0%, #E8ECFF 42%, #F2F2F7 100%);
  box-sizing: border-box;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #6E6E73;
}

.detail-shell {
  min-height: calc(100vh - 112rpx);
  display: flex;
  flex-direction: column;
}

.word-hero {
  margin-top: 18rpx;
}

.word-title {
  font-size: 92rpx;
  line-height: 1.05;
  font-weight: 900;
  letter-spacing: 0;
  color: #111113;
  word-break: break-word;
}

.phonetic-row {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex-wrap: wrap;
}

.pron-chip {
  width: 74rpx;
  min-width: 74rpx;
  height: 40rpx;
  padding: 0 14rpx;
  margin: 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.32);
  color: rgba(60, 60, 67, 0.74);
  font-size: 24rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  box-sizing: border-box;
  flex: 0 0 auto;
}

.audio-icon {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.phonetic {
  font-size: 40rpx;
  line-height: 1.2;
  color: rgba(60, 60, 67, 0.68);
  flex: 0 1 auto;
}

.definition-block {
  margin-top: 46rpx;
  font-size: 38rpx;
  line-height: 1.62;
  color: #171719;
  word-break: break-word;
}

.pos {
  margin-right: 18rpx;
  font-weight: 400;
}

.definition-text {
  font-weight: 500;
}

.definition-en {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.65;
  color: rgba(60, 60, 67, 0.66);
}

.example-card,
.pattern-card {
  margin-left: -24rpx;
  margin-right: -24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.38);
  border: 2rpx solid rgba(255, 255, 255, 0.32);
  box-shadow: 0 18rpx 48rpx rgba(0, 122, 255, 0.08);
}

.example-card {
  margin-top: 48rpx;
  padding: 30rpx 30rpx 34rpx;
}

.example-sentence {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  font-size: 34rpx;
  line-height: 1.45;
  color: #171719;
  word-break: break-word;
}

.sentence-audio {
  width: 36rpx;
  height: 48rpx;
  padding: 0;
  margin: 0;
  border-radius: 999rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.example-en {
  flex: 1;
  min-width: 0;
}

.example-zh {
  margin-top: 22rpx;
  font-size: 32rpx;
  line-height: 1.55;
  color: #1D1D1F;
}

.pattern-card {
  min-height: 504rpx;
  margin-top: 24rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
}

.pattern-content {
  font-size: 34rpx;
  line-height: 1.62;
  color: #1D1D1F;
  white-space: pre-wrap;
}

.source-line {
  margin-top: auto;
  padding-top: 24rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(60, 60, 67, 0.55);
}

.answer-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
  gap: 22rpx;
  width: 100%;
  margin-top: 56rpx;
}

.answer-btn {
  width: auto;
  height: 96rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  color: #111113;
  font-size: 34rpx;
  line-height: 1.1;
  font-weight: 900;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  box-sizing: border-box;
}

.answer-btn.disabled {
  opacity: 0.55;
  pointer-events: none;
}

.answer-mark {
  width: 40rpx;
  height: 10rpx;
  border-radius: 999rpx;
}

.answer-btn.known .answer-mark {
  background: var(--primary);
}

.answer-btn.fuzzy .answer-mark {
  background: var(--warning);
}

.answer-btn.unknown .answer-mark {
  background: var(--error);
}
