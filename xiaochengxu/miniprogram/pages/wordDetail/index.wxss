.word-detail-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 190rpx;
  background: linear-gradient(138deg, #DBE8FF 0%, #EEF5FF 36%, #FBFDFF 68%, #EEF3F8 100%);
  box-sizing: border-box;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #6E6E73;
}

.detail-shell {
  min-height: calc(100vh - 214rpx);
}

.top-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 2rpx solid #ECECF0;
  box-shadow: 0 12rpx 30rpx rgba(17, 24, 39, 0.04);
}

.round-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #F2F2F7;
  color: #1D1D1F;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 850;
}

.sound-round .audio-icon {
  width: 32rpx;
  height: 32rpx;
}

.book-meta {
  flex: 1;
  min-width: 0;
}

.page-title {
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 850;
  color: #1D1D1F;
}

.word-hero {
  margin-top: 28rpx;
  padding: 48rpx 28rpx 46rpx;
  border-radius: 38rpx;
  text-align: left;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.78)),
    linear-gradient(135deg, rgba(47, 111, 237, 0.12), rgba(0, 122, 255, 0.08));
  border: 2rpx solid rgba(212, 219, 231, 0.9);
  box-shadow: 0 18rpx 48rpx rgba(47, 111, 237, 0.1);
}

.word-main-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 22rpx;
}

.word-title {
  font-size: 86rpx;
  line-height: 1;
  font-weight: 650;
  color: #111113;
  word-break: break-word;
}

.hero-audio {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(47, 111, 237, 0.2);
  box-shadow: 0 14rpx 34rpx rgba(47, 111, 237, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hero-audio .audio-icon {
  width: 38rpx;
  height: 38rpx;
}

.phonetic-row {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
  flex-wrap: wrap;
}

.pron-chip {
  min-width: 78rpx;
  height: 54rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #EDF5FF;
  color: #007AFF;
  font-size: 28rpx;
  font-weight: 850;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  box-sizing: border-box;
}

.audio-icon {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.phonetic {
  font-size: 30rpx;
  line-height: 1.2;
  color: rgba(60, 60, 67, 0.68);
}

.meaning-lines {
  display: grid;
  gap: 14rpx;
  margin-top: 34rpx;
  color: #20212A;
}

.meaning-line {
  font-size: 35rpx;
  line-height: 1.5;
  word-break: break-word;
}

.meaning-mark {
  padding-bottom: 5rpx;
  background: linear-gradient(to right, rgba(0, 0, 0, 0.26) 48%, transparent 0) left bottom / 12rpx 2rpx repeat-x;
}

.meaning-en {
  font-size: 26rpx;
  line-height: 1.58;
  color: #667085;
}

.detail-card {
  margin-top: 22rpx;
  padding: 0;
  border-radius: 30rpx;
  background: transparent;
}

.example-card,
.pattern-card {
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.58);
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 44rpx rgba(47, 111, 237, 0.1);
}

.example-card {
  position: relative;
  padding: 34rpx 88rpx 34rpx 34rpx;
}

.sentence-audio {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background: rgba(245, 247, 251, 0.76);
  border: 2rpx solid rgba(47, 111, 237, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sentence-audio .audio-icon {
  width: 34rpx;
  height: 34rpx;
}

.example-en {
  font-size: 36rpx;
  line-height: 1.5;
  color: #20212A;
  font-weight: 800;
  word-break: break-word;
}

.example-zh {
  margin-top: 22rpx;
  padding-left: 0;
  font-size: 32rpx;
  line-height: 1.55;
  color: rgba(32, 33, 42, 0.76);
}

.pattern-content {
  padding: 30rpx 34rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #1D1D1F;
  white-space: pre-wrap;
}

.source-line {
  display: inline-flex;
  margin: 18rpx 34rpx 30rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #F2F2F7;
  color: #8E8E93;
  font-size: 24rpx;
  line-height: 1.5;
}

.answer-row {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18rpx;
  z-index: 10;
}

.answer-btn {
  height: 86rpx;
  padding: 0;
  margin: 0;
  border-radius: 28rpx;
  font-size: 30rpx;
  line-height: 1;
  font-weight: 850;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.answer-btn::after {
  border: none;
}

.answer-btn.disabled {
  opacity: 0.55;
  pointer-events: none;
}

.answer-btn.known {
  color: #258A45;
  background: #F1FBF5;
}

.answer-btn.fuzzy {
  color: #9A6A00;
  background: #FFF8E8;
}

.answer-btn.unknown {
  color: #D23B31;
  background: #FFF2F1;
}
