.word-detail-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 190rpx;
  background: linear-gradient(180deg, #F8FBFF 0%, #F5F7FA 44%, #EEF2F7 100%);
  box-sizing: border-box;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #6E6E73;
}

.detail-shell {
  min-height: calc(100vh - 214rpx);
}

.top-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 2rpx solid #ECECF0;
  box-shadow: 0 12rpx 30rpx rgba(17, 24, 39, 0.04);
}

.round-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #F2F2F7;
  color: #1D1D1F;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 850;
}

.book-meta {
  flex: 1;
  min-width: 0;
}

.page-title {
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 850;
  color: #1D1D1F;
}

.word-hero {
  margin-top: 28rpx;
  padding: 64rpx 28rpx 56rpx;
  border-radius: 38rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.74);
  box-shadow: 0 10rpx 28rpx rgba(17, 24, 39, 0.035);
}

.word-title {
  font-size: 104rpx;
  line-height: 1;
  font-weight: 700;
  color: #111113;
  word-break: break-word;
}

.phonetic-row {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.pron-chip {
  min-width: 78rpx;
  height: 54rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #EDF5FF;
  color: #007AFF;
  font-size: 28rpx;
  font-weight: 850;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  box-sizing: border-box;
}

.audio-icon {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.phonetic {
  font-size: 34rpx;
  line-height: 1.2;
  color: rgba(60, 60, 67, 0.68);
}

.detail-card {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid #ECECF0;
  box-shadow: 0 8rpx 24rpx rgba(17, 24, 39, 0.04);
}

.definition-block {
  font-size: 34rpx;
  line-height: 1.55;
  color: #1D1D1F;
  word-break: break-word;
}

.pos {
  display: inline-flex;
  margin-right: 14rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EDF5FF;
  color: #007AFF;
  font-size: 24rpx;
  font-weight: 850;
}

.definition-text {
  font-weight: 750;
}

.definition-en {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #6E6E73;
}

.example-card,
.pattern-card {
  border-radius: 26rpx;
  background: #F2F2F7;
}

.example-card {
  padding: 24rpx;
}

.example-sentence {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  font-size: 30rpx;
  line-height: 1.45;
  color: #1D1D1F;
  word-break: break-word;
}

.sentence-audio {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #007AFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sentence-audio .audio-icon {
  width: 28rpx;
  height: 28rpx;
  filter: brightness(0) invert(1);
}

.example-en {
  flex: 1;
  min-width: 0;
  font-weight: 800;
}

.example-zh {
  margin-top: 14rpx;
  padding-left: 76rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #6E6E73;
}

.pattern-content {
  font-size: 28rpx;
  line-height: 1.6;
  color: #1D1D1F;
  white-space: pre-wrap;
}

.source-line {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #F2F2F7;
  color: #8E8E93;
  font-size: 24rpx;
  line-height: 1.5;
}

.answer-row {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18rpx;
  z-index: 10;
}

.answer-btn {
  height: 86rpx;
  padding: 0;
  margin: 0;
  border-radius: 28rpx;
  font-size: 30rpx;
  line-height: 1;
  font-weight: 850;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.answer-btn::after {
  border: none;
}

.answer-btn.disabled {
  opacity: 0.55;
  pointer-events: none;
}

.answer-btn.known {
  color: #258A45;
  background: #F1FBF5;
}

.answer-btn.fuzzy {
  color: #9A6A00;
  background: #FFF8E8;
}

.answer-btn.unknown {
  color: #D23B31;
  background: #FFF2F1;
}
