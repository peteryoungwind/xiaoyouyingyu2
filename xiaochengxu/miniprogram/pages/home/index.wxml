<view class="page-container safe-bottom">

  <!-- Header -->
  <view class="header">
    <view>
      <view class="header-greeting">{{greetingText}}</view>
      <view class="header-title">今天想聊点什么？</view>
    </view>
    <view class="header-search" bindtap="onSearchTap">
      <text class="search-icon-btn">🔍</text>
    </view>
  </view>

  <!-- 学习概览卡片 -->
  <view class="stats-card" bindtap="goToLearning">
    <view class="stats-left">
      <view class="stats-icon-wrap">
        <text class="stats-flame">🔥</text>
      </view>
      <view class="stats-info">
        <view class="stats-label">今日学习进度</view>
        <view class="stats-text">已坚持 {{stats.days}} 天，继续加油！</view>
      </view>
    </view>
    <text class="stats-arrow">›</text>
  </view>

  <!-- 主题分类 -->
  <view class="section" wx:if="{{tagCategories.length > 0}}">
    <view class="section-header">
      <text class="section-title">主题分类</text>
      <text class="section-more" bindtap="goToTopics">查看全部</text>
    </view>
    <view class="explore-grid">
      <view wx:for="{{tagCategories}}" wx:key="name" class="explore-item" bindtap="onCategoryTap" data-tag="{{item.name}}">
        <view class="explore-icon" style="background: linear-gradient(135deg, {{item.gradientFrom}}, {{item.gradientTo}})">
          <text>{{item.icon}}</text>
        </view>
        <text class="explore-name">{{item.name}}</text>
        <text class="explore-count">{{item.count}}</text>
      </view>
    </view>
  </view>

  <!-- 本周最热 -->
  <view class="section" wx:if="{{latestTopics.length > 0}}">
    <view class="section-header">
      <view class="section-title-wrap">
        <text class="section-title">本周最热</text>
        <view class="hot-badge">Hot</view>
      </view>
    </view>
    <view class="topic-list">
      <view wx:for="{{latestTopics}}" wx:key="id" class="topic-card" bindtap="goToTopicDetail" data-id="{{item.id}}">
        <view class="topic-left">
          <view class="topic-icon" style="background: {{item.iconBg}}">
            <text>💬</text>
          </view>
          <view class="topic-info">
            <view class="topic-tags-row">
              <text wx:if="{{item.firstTag}}" class="topic-tag-badge">{{item.firstTag}}</text>
              <text class="topic-date-label">{{item.eventDate}}</text>
            </view>
            <view class="topic-name">{{item.titleZh || item.title}}</view>
            <view class="topic-sub">{{item.title}}</view>
          </view>
        </view>
        <view class="topic-arrow-wrap">
          <text class="topic-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部提示 -->
  <view class="footer-hint">
    <text class="footer-text">更多主题持续更新中</text>
    <view class="footer-bar"></view>
  </view>

  <!-- Login Guide -->
  <view class="login-guide card" wx:if="{{!isLoggedIn}}" bindtap="goToLogin">
    <view class="login-guide-text">登录后解锁搜索和学习功能</view>
    <view class="btn btn-primary btn-sm">立即登录</view>
  </view>

</view>
