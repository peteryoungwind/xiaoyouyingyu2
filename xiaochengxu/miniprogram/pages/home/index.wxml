<view class="page-container safe-bottom home-page">
  <view class="hero-card" bindtap="goToLearning">
    <view class="hero-badge">Daily Practice</view>
    <view class="hero-title">今天想聊点什么？</view>
    <view class="hero-footer simple">
      <view class="hero-progress">
        <text class="hero-progress-value">已坚持 {{stats.days}} 天</text>
        <text class="hero-progress-label">浏览主题或进入学习中心继续练习。</text>
      </view>
      <view class="hero-action">去学习</view>
    </view>
  </view>

  <view class="study-entry-grid">
    <view class="study-entry-item word" bindtap="goToWordPractice">
      <view class="study-entry-icon">
        <view class="icon-book">
          <view class="icon-book-left"></view>
          <view class="icon-book-right"></view>
        </view>
      </view>
      <view class="study-entry-title">单词练习</view>
    </view>
    <view class="study-entry-item dialog" bindtap="goToAiDialog">
      <view class="study-entry-icon">
        <view class="icon-chat">
          <view class="icon-chat-line long"></view>
          <view class="icon-chat-line short"></view>
        </view>
      </view>
      <view class="study-entry-title">AI 对话</view>
    </view>
    <view class="study-entry-item article" bindtap="goToDailyArticles">
      <view class="study-entry-icon">
        <view class="icon-article">
          <view class="icon-article-line title-line"></view>
          <view class="icon-article-line"></view>
          <view class="icon-article-line narrow"></view>
        </view>
      </view>
      <view class="study-entry-title">每日外刊</view>
    </view>
    <view class="study-entry-item listening" bindtap="goToShadowingLessons">
      <view class="study-entry-icon">
        <view class="icon-headphone">
          <view class="icon-headphone-band"></view>
          <view class="icon-headphone-ear left"></view>
          <view class="icon-headphone-ear right"></view>
        </view>
      </view>
      <view class="study-entry-title">跟读精听</view>
    </view>
  </view>

  <view class="overview-grid">
    <view class="overview-card">
      <view class="overview-label">主题总数</view>
      <view class="overview-value">{{totalTopics}}</view>
      <view class="overview-note">持续更新</view>
    </view>
    <view class="overview-card">
      <view class="overview-label">连续天数</view>
      <view class="overview-value">{{stats.days}}</view>
      <view class="overview-note">学习节奏</view>
    </view>
    <view class="overview-card">
      <view class="overview-label">热门标签</view>
      <view class="overview-value">{{tagCategories.length}}</view>
      <view class="overview-note">分类浏览</view>
    </view>
  </view>

  <view class="section" wx:if="{{tagCategories.length > 0}}">
    <view class="section-header">
      <view>
        <text class="section-title">热门标签</text>
      </view>
      <text class="section-more" bindtap="goToTopics">查看全部</text>
    </view>
    <view class="explore-grid compact-grid">
      <view wx:for="{{tagCategories}}" wx:key="name" class="explore-item compact-item ios-tag-item" style="background: {{item.cardBg}}; border-color: {{item.cardBorder}};" bindtap="onCategoryTap" data-tag="{{item.name}}">
        <view class="explore-icon compact-icon ios-tag-icon" style="background: {{item.iconBg}};">
          <image class="explore-icon-image ios-tag-image" src="{{item.icon}}" mode="aspectFit" />
        </view>
        <text class="explore-name compact-name ios-tag-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{latestTopics.length > 0}}">
    <view class="section-header">
      <view>
        <text class="section-title">最新主题</text>
      </view>
      <text class="section-more" bindtap="goToTopics">全部主题</text>
    </view>
    <view class="topic-list">
      <view wx:for="{{latestTopics}}" wx:key="id" class="topic-card" bindtap="goToTopicDetail" data-id="{{item.id}}">
        <view class="topic-left">
          <view class="topic-icon" style="background: {{item.iconBg}}">
            <text class="topic-icon-text">✦</text>
          </view>
          <view class="topic-info">
            <view class="topic-tags-row">
              <text wx:if="{{item.firstTag}}" class="topic-tag-badge">{{item.firstTag}}</text>
              <text class="topic-date-label">{{item.eventDate}}</text>
            </view>
            <view class="topic-name">{{item.titleZh || item.title}}</view>
            <view class="topic-sub">{{item.title}}</view>
          </view>
        </view>
        <view class="topic-arrow-wrap">
          <text class="topic-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="member-card" wx:if="{{!isMember}}">
    <view class="member-badge">会员专属</view>
    <view class="member-title">解锁完整学习体验</view>
    <view class="member-desc">开通会员后可使用学习中心、AI 点评等进阶功能。</view>
    <view class="member-actions">
      <view class="member-action primary" bindtap="goToLearning">了解学习功能</view>
      <view class="member-action secondary" wx:if="{{!isLoggedIn}}" bindtap="goToLogin">立即登录</view>
      <view class="member-action secondary" wx:if="{{!isLoggedIn}}" bindtap="goToTopics">以游客身份浏览</view>
    </view>
  </view>

  <view class="footer-hint">
    <text class="footer-text">更多主题持续更新中</text>
    <view class="footer-bar"></view>
  </view>
</view>
