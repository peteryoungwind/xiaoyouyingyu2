/* ===== Homepage Styles ===== */

/* Header */
.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 32rpx;
}
.header-greeting {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 2rpx;
}
.header-title {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -1rpx;
  margin-top: 4rpx;
}
.header-search {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #F2F2F7;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--border);
}
.search-icon-btn {
  font-size: 36rpx;
}

/* Stats Card */
.stats-card {
  background: linear-gradient(135deg, #007AFF, #5856D6);
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(0, 122, 255, 0.2);
}
.stats-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.stats-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.stats-flame {
  font-size: 40rpx;
}
.stats-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.stats-label {
  font-size: 20rpx;
  font-weight: 700;
  opacity: 0.8;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}
.stats-text {
  font-size: 28rpx;
  font-weight: 700;
}
.stats-arrow {
  font-size: 36rpx;
  opacity: 0.6;
}

/* Section */
.section {
  margin-bottom: 40rpx;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary);
}
.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.section-more {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 700;
}
.hot-badge {
  background: #FFEBEE;
  color: #FF3B30;
  font-size: 18rpx;
  font-weight: 800;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  text-transform: uppercase;
  letter-spacing: -1rpx;
}

/* Explore Grid (tag categories, 4 per row) */
.explore-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx 0;
}
.explore-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: 25%;
}
.explore-item:active {
  transform: scale(0.95);
}
.explore-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}
.explore-name {
  font-size: 22rpx;
  font-weight: 700;
  color: #636366;
  max-width: 140rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-align: center;
}
.explore-count {
  font-size: 18rpx;
  color: var(--text-hint);
}

/* Topic List */
.topic-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.topic-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid #F2F2F7;
}
.topic-card:active {
  background: #F9F9F9;
}
.topic-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
  min-width: 0;
}
.topic-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}
.topic-info {
  flex: 1;
  min-width: 0;
}
.topic-tags-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.topic-tag-badge {
  font-size: 18rpx;
  font-weight: 800;
  color: var(--primary);
  background: #E5F1FF;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  text-transform: uppercase;
}
.topic-date-label {
  font-size: 18rpx;
  font-weight: 700;
  color: var(--text-hint);
}
.topic-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #1C1C1E;
  letter-spacing: -0.5rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.topic-sub {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.topic-arrow-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F2F2F7;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.topic-arrow {
  font-size: 32rpx;
  color: #C7C7CC;
}

/* Footer Hint */
.footer-hint {
  padding: 32rpx 0 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.footer-text {
  font-size: 22rpx;
  color: #C7C7CC;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}
.footer-bar {
  width: 80rpx;
  height: 6rpx;
  background: #E5E5EA;
  border-radius: 3rpx;
}

/* Login Guide */
.login-guide {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.login-guide-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}
