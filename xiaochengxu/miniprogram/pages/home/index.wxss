/* ===== Homepage Styles ===== */
.home-page {
  background: #F5F5F7;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.header-search-only {
  justify-content: flex-end;
  margin-bottom: 16rpx;
}

.compact-header {
  align-items: center;
}

.header-copy {
  flex: 1;
  min-width: 0;
  padding-right: 24rpx;
}

.brand-row {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 2rpx solid #EEF0F4;
  box-shadow: 0 10rpx 30rpx rgba(17, 24, 39, 0.04);
  margin-bottom: 16rpx;
}

.brand-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #007AFF;
}

.brand-name {
  font-size: 22rpx;
  line-height: 1;
  font-weight: 600;
  color: #6E6E73;
}

.header-greeting {
  font-size: 22rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #8E8E93;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}

.header-title {
  font-size: 56rpx;
  line-height: 1.16;
  font-weight: 800;
  color: #1D1D1F;
  letter-spacing: -1.2rpx;
}

.header-subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #6E6E73;
}

.header-search {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.88);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #EEF0F4;
  box-shadow: 0 12rpx 32rpx rgba(17, 24, 39, 0.05);
  flex-shrink: 0;
}

.search-icon-btn {
  font-size: 36rpx;
  color: #1D1D1F;
  line-height: 1;
}

.hero-card {
  background: #EAF3FF;
  border: 2rpx solid rgba(0, 122, 255, 0.08);
  border-radius: 34rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 122, 255, 0.08);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #007AFF;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.8rpx;
  margin-bottom: 22rpx;
}

.hero-title {
  font-size: 42rpx;
  line-height: 1.24;
  font-weight: 800;
  color: #1D1D1F;
}

.hero-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #4D4D52;
}

.hero-footer {
  margin-top: 24rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
}

.hero-footer.simple {
  align-items: center;
}

.hero-progress {
  flex: 1;
  min-width: 0;
}

.hero-progress-value {
  display: block;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #1D1D1F;
}

.hero-progress-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #6E6E73;
}

.hero-action {
  min-width: 152rpx;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 22rpx;
  background: #007AFF;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20rpx;
  margin-bottom: 44rpx;
}

.study-entry-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.study-entry-item {
  min-width: 0;
  height: 154rpx;
  padding: 18rpx 8rpx 16rpx;
  box-sizing: border-box;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(229, 229, 234, 0.86);
  box-shadow: 0 10rpx 28rpx rgba(17, 24, 39, 0.035);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.study-entry-item:active {
  transform: scale(0.98);
}

.study-entry-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 25rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.study-entry-title {
  width: 100%;
  font-size: 22rpx;
  line-height: 1.25;
  font-weight: 600;
  color: #1D1D1F;
  text-align: center;
  white-space: nowrap;
}

.study-entry-item.word .study-entry-icon {
  background: #EAF7EE;
  color: #2F8F55;
}

.study-entry-item.dialog .study-entry-icon {
  background: #EAF3FF;
  color: #3D8BFF;
}

.study-entry-item.article .study-entry-icon {
  background: #EAF8F3;
  color: #25A47B;
}

.study-entry-item.listening .study-entry-icon {
  background: #F1EDFF;
  color: #7A68D8;
}

.icon-book {
  width: 38rpx;
  height: 34rpx;
  position: relative;
  display: flex;
  gap: 4rpx;
}

.icon-book-left,
.icon-book-right {
  width: 18rpx;
  height: 34rpx;
  box-sizing: border-box;
  border: 3rpx solid currentColor;
  background: rgba(255, 255, 255, 0.32);
}

.icon-book-left {
  border-radius: 8rpx 3rpx 3rpx 8rpx;
}

.icon-book-right {
  border-radius: 3rpx 8rpx 8rpx 3rpx;
}

.icon-chat {
  width: 40rpx;
  height: 34rpx;
  box-sizing: border-box;
  border: 3rpx solid currentColor;
  border-radius: 15rpx;
  position: relative;
}

.icon-chat::after {
  content: "";
  position: absolute;
  right: 7rpx;
  bottom: -7rpx;
  width: 12rpx;
  height: 12rpx;
  box-sizing: border-box;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  background: inherit;
  transform: rotate(38deg);
  border-radius: 0 0 4rpx 0;
}

.icon-chat-line {
  position: absolute;
  left: 9rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
  opacity: 0.72;
}

.icon-chat-line.long {
  top: 11rpx;
  width: 20rpx;
}

.icon-chat-line.short {
  top: 20rpx;
  width: 14rpx;
}

.icon-article {
  width: 34rpx;
  height: 40rpx;
  box-sizing: border-box;
  border: 3rpx solid currentColor;
  border-radius: 9rpx;
  position: relative;
}

.icon-article-line {
  position: absolute;
  left: 7rpx;
  width: 19rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
  opacity: 0.72;
}

.icon-article-line.title-line {
  top: 10rpx;
}

.icon-article-line:not(.title-line):not(.narrow) {
  top: 19rpx;
}

.icon-article-line.narrow {
  top: 28rpx;
  width: 13rpx;
}

.icon-headphone {
  width: 42rpx;
  height: 40rpx;
  position: relative;
}

.icon-headphone-band {
  position: absolute;
  top: 2rpx;
  left: 5rpx;
  width: 32rpx;
  height: 30rpx;
  box-sizing: border-box;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 22rpx 22rpx 0 0;
}

.icon-headphone-ear {
  position: absolute;
  bottom: 2rpx;
  width: 10rpx;
  height: 18rpx;
  border-radius: 7rpx;
  background: currentColor;
  opacity: 0.78;
}

.icon-headphone-ear.left {
  left: 3rpx;
}

.icon-headphone-ear.right {
  right: 3rpx;
}

.overview-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  border: 2rpx solid #EEF0F4;
  box-shadow: 0 12rpx 30rpx rgba(17, 24, 39, 0.04);
}

.overview-label {
  font-size: 22rpx;
  line-height: 1.4;
  color: #8E8E93;
}

.overview-value {
  margin-top: 14rpx;
  font-size: 44rpx;
  line-height: 1.05;
  font-weight: 800;
  color: #1D1D1F;
}

.overview-note {
  margin-top: 12rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: #6E6E73;
}

.section {
  margin-bottom: 36rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 36rpx;
  line-height: 1.22;
  font-weight: 800;
  color: #1D1D1F;
}

.section-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8E8E93;
}

.section-more {
  font-size: 24rpx;
  line-height: 1.4;
  color: #007AFF;
  font-weight: 700;
  flex-shrink: 0;
}

.explore-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.compact-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16rpx;
}

.explore-item {
  background: #FFFFFF;
  border-radius: 30rpx;
  padding: 28rpx 24rpx;
  border: 2rpx solid #EEF0F4;
  box-shadow: 0 12rpx 30rpx rgba(17, 24, 39, 0.04);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.ios-tag-item {
  border-radius: 40rpx;
  padding: 24rpx 10rpx 18rpx;
  border: 2rpx solid #ECECF0;
  box-shadow: 0 6rpx 18rpx rgba(17, 24, 39, 0.03);
  align-items: center;
}

.compact-item {
  align-items: center;
  padding: 22rpx 10rpx 18rpx;
  border-radius: 24rpx;
}

.explore-item:active {
  transform: scale(0.98);
}

.explore-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(60, 60, 67, 0.06);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.5);
  overflow: hidden;
}

.compact-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
}

.ios-tag-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  border: none;
  box-shadow: none;
}

.explore-icon-image {
  width: 50rpx;
  height: 50rpx;
  display: block;
}

.compact-icon .explore-icon-image {
  width: 36rpx;
  height: 36rpx;
}

.ios-tag-image {
  width: 38rpx;
  height: 38rpx;
}

.explore-name {
  margin-top: 22rpx;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #1D1D1F;
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.compact-name {
  margin-top: 12rpx;
  font-size: 22rpx;
  text-align: center;
}

.ios-tag-name {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 600;
  color: #1D1D1F;
  text-align: center;
}

.explore-count {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #8E8E93;
}

.topic-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.topic-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx;
  border: 2rpx solid #EEF0F4;
  box-shadow: 0 14rpx 32rpx rgba(17, 24, 39, 0.04);
}

.topic-card:active {
  transform: scale(0.99);
}

.topic-left {
  display: flex;
  align-items: center;
  gap: 22rpx;
  flex: 1;
  min-width: 0;
}

.topic-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.topic-icon-text {
  font-size: 32rpx;
  color: #1D1D1F;
  line-height: 1;
}

.topic-info {
  flex: 1;
  min-width: 0;
}

.topic-tags-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.topic-tag-badge {
  font-size: 18rpx;
  line-height: 32rpx;
  font-weight: 700;
  color: #007AFF;
  background: #EAF3FF;
  padding: 0 14rpx;
  border-radius: 999rpx;
}

.topic-date-label {
  font-size: 20rpx;
  line-height: 1.4;
  color: #8E8E93;
}

.topic-name {
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #1D1D1F;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.topic-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #6E6E73;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.topic-arrow-wrap {
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  background: #FBFBFD;
  border: 2rpx solid #EEF0F4;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.topic-arrow {
  font-size: 32rpx;
  color: #C7C7CC;
  line-height: 1;
}

.learning-entry-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 30rpx 28rpx;
  border: 2rpx solid #EEF0F4;
  box-shadow: 0 14rpx 32rpx rgba(17, 24, 39, 0.04);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.learning-entry-copy {
  flex: 1;
  min-width: 0;
}

.learning-entry-title {
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #1D1D1F;
}

.learning-entry-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #6E6E73;
}

.learning-entry-btn {
  height: 68rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: #FBFBFD;
  border: 2rpx solid #E5E5EA;
  font-size: 24rpx;
  font-weight: 700;
  color: #007AFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.member-card {
  background: #FFF5E8;
  border-radius: 32rpx;
  padding: 32rpx 30rpx;
  border: 2rpx solid rgba(201, 151, 77, 0.16);
  box-shadow: 0 14rpx 32rpx rgba(201, 151, 77, 0.08);
  margin-bottom: 24rpx;
}

.member-badge {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #C9974D;
  font-size: 20rpx;
  font-weight: 700;
}

.member-title {
  margin-top: 18rpx;
  font-size: 34rpx;
  line-height: 1.28;
  font-weight: 800;
  color: #1D1D1F;
}

.member-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.68;
  color: #6E6E73;
}

.member-actions {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.member-action {
  height: 68rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.member-action.primary {
  background: #C9974D;
  color: #FFFFFF;
}

.member-action.secondary {
  background: rgba(255, 255, 255, 0.84);
  color: #8C6A43;
}

.login-guide {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  border: 2rpx solid #EEF0F4;
  box-shadow: 0 14rpx 32rpx rgba(17, 24, 39, 0.04);
}

.login-guide-copy {
  flex: 1;
  min-width: 0;
}

.login-guide-title {
  font-size: 28rpx;
  line-height: 1.38;
  font-weight: 700;
  color: #1D1D1F;
}

.login-guide-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #6E6E73;
}

.footer-hint {
  padding: 12rpx 0 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #8E8E93;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.footer-bar {
  width: 84rpx;
  height: 6rpx;
  background: #D9DCE3;
  border-radius: 999rpx;
}
