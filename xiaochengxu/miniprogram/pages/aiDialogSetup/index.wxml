<view class="page safe-bottom">
  <view class="header">
    <view class="eyebrow">AI Dialog</view>
    <view class="title">开始一段主题对话</view>
    <view class="subtitle">选择模式、难度和主题，然后用文字或语音开始练习。</view>
  </view>

  <button class="top-start-btn" bindtap="startDialog" disabled="{{configLoading || (config && !config.enabled)}}">开始对话</button>

  <view class="config-row" wx:if="{{config}}">
    <view class="quota-card">
      <text>今日剩余</text>
      <view>{{config.remainingToday}} 轮</view>
    </view>
    <view class="quota-card">
      <text>本次最多</text>
      <view>{{config.maxRoundsPerSession}} 轮</view>
    </view>
  </view>

  <view wx:if="{{error}}" class="notice">{{error}}</view>

  <view class="selector-panel">
    <view class="choice-header">
      <view class="label">选择模式</view>
      <view class="choice-meta">回复方式</view>
    </view>
    <view class="choice-grid">
      <view class="choice-card {{mode === 'TEACHING' ? 'active' : ''}}" bindtap="setMode" data-value="TEACHING">
        <view class="choice-name">教学模式</view>
        <view class="choice-desc">英文回复后补充中文点评和优化表达。</view>
        <view wx:if="{{mode === 'TEACHING'}}" class="choice-check">✓</view>
      </view>
      <view class="choice-card {{mode === 'PRACTICE' ? 'active' : ''}}" bindtap="setMode" data-value="PRACTICE">
        <view class="choice-name">练习模式</view>
        <view class="choice-desc">更少提示，保留真实对话节奏。</view>
        <view wx:if="{{mode === 'PRACTICE'}}" class="choice-check">✓</view>
      </view>
    </view>
  </view>

  <view class="selector-panel">
    <view class="choice-header">
      <view class="label">选择难度</view>
      <view class="choice-meta">语言复杂度</view>
    </view>
    <view class="choice-grid">
      <view class="choice-card {{difficulty === 'BEGINNER' ? 'active' : ''}}" bindtap="setDifficulty" data-value="BEGINNER">
        <view class="choice-name">初级</view>
        <view class="choice-desc">短句、常用词，适合先开口。</view>
        <view wx:if="{{difficulty === 'BEGINNER'}}" class="choice-check">✓</view>
      </view>
      <view class="choice-card {{difficulty === 'ADVANCED' ? 'active' : ''}}" bindtap="setDifficulty" data-value="ADVANCED">
        <view class="choice-name">进阶</view>
        <view class="choice-desc">更自然的表达和观点展开。</view>
        <view wx:if="{{difficulty === 'ADVANCED'}}" class="choice-check">✓</view>
      </view>
    </view>
  </view>

  <view class="selector-panel">
    <view class="choice-header">
      <view class="label">选择主题</view>
      <view class="choice-meta">对话内容</view>
    </view>
    <view class="topic-tabs">
      <view class="topic-tab {{topicSource === 'SYSTEM' ? 'active' : ''}}" bindtap="setTopicSource" data-value="SYSTEM">已有主题</view>
      <view class="topic-tab {{topicSource === 'CUSTOM' ? 'active' : ''}}" bindtap="setTopicSource" data-value="CUSTOM">自定义主题</view>
    </view>

    <view wx:if="{{topicSource === 'SYSTEM'}}" class="topic-picker">
      <view class="search-box">
        <input value="{{keyword}}" bindinput="onKeywordInput" bindconfirm="onSearch" confirm-type="search" placeholder="搜索主题" placeholder-class="placeholder" />
        <view class="search-btn" bindtap="onSearch">搜索</view>
      </view>

      <view wx:if="{{selectedTopic}}" class="topic-picked">
        <view class="topic-picked-mark">✓</view>
        <view class="topic-main">
          <view class="topic-title">{{selectedTopic.titleZh || selectedTopic.title}}</view>
          <view class="topic-sub">{{selectedTopic.title}}</view>
          <view wx:if="{{selectedTopic.tagsText}}" class="topic-tags">{{selectedTopic.tagsText}}</view>
        </view>
      </view>

      <view class="list-guide">{{searched ? '搜索结果' : '最近 5 条主题'}}</view>
      <view wx:if="{{topics.length === 0 && !topicsLoading}}" class="empty">暂无主题，可切换为自定义主题。</view>
      <view wx:for="{{topics}}" wx:key="id" class="topic-item {{topicId === item.id ? 'selected' : ''}}" bindtap="selectTopic" data-id="{{item.id}}">
        <view class="topic-main">
          <view class="topic-title">{{item.titleZh || item.title}}</view>
          <view class="topic-sub">{{item.title}}</view>
          <view wx:if="{{item.tagsText}}" class="topic-tags">{{item.tagsText}}</view>
        </view>
        <view class="check">{{topicId === item.id ? '✓' : ''}}</view>
      </view>
      <view wx:if="{{topicsLoading}}" class="loading">加载中...</view>
    </view>

    <view wx:else class="custom-box">
      <textarea maxlength="100" value="{{customTopic}}" bindinput="onCustomTopicInput" placeholder="输入你想练习的主题，例如：Working from home" placeholder-class="placeholder" />
      <view class="counter">{{customTopic.length}}/100</view>
    </view>
  </view>

</view>
