.page {
  min-height: 100vh;
  padding: 36rpx 28rpx 48rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #F5F7FA 46%, #EEF2F7 100%);
  box-sizing: border-box;
}

.header { margin-bottom: 20rpx; }
.eyebrow { font-size: 22rpx; font-weight: 800; color: #007AFF; text-transform: uppercase; letter-spacing: 1.5rpx; }
.title { margin-top: 10rpx; font-size: 46rpx; line-height: 1.2; font-weight: 850; color: #1D1D1F; }
.subtitle { margin-top: 12rpx; font-size: 26rpx; line-height: 1.6; color: #6E6E73; }

.top-start-btn {
  width: 432rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 24rpx auto 20rpx;
  border-radius: 30rpx;
  background: #007AFF;
  color: #FFFFFF;
  font-size: 31rpx;
  font-weight: 850;
  line-height: 1;
  padding: 0;
  box-shadow: 0 16rpx 34rpx rgba(0, 122, 255, 0.22);
}

.top-start-btn::after {
  border: none;
}

.top-start-btn[disabled] {
  background: #C7C7CC;
  color: #FFFFFF;
  box-shadow: none;
}

.notice {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #FFF2F2;
  color: #D70015;
  font-size: 26rpx;
}

.selector-panel {
  margin-bottom: 20rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(229, 229, 234, 0.78);
  box-shadow: 0 8rpx 24rpx rgba(17, 24, 39, 0.035);
}

.choice-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.label {
  font-size: 28rpx;
  line-height: 1.25;
  font-weight: 850;
  color: #1D1D1F;
}

.choice-meta {
  flex-shrink: 0;
  color: #8E8E93;
  font-size: 23rpx;
  font-weight: 750;
}

.choice-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.choice-card {
  position: relative;
  min-height: 132rpx;
  padding: 26rpx 54rpx 24rpx 24rpx;
  border-radius: 26rpx;
  border: 2rpx solid #E5EAF2;
  background: #FBFCFF;
  box-sizing: border-box;
}

.choice-card.active {
  border-color: rgba(0, 122, 255, 0.56);
  background: linear-gradient(180deg, #F8FBFF 0%, #EFF7FF 100%);
  box-shadow: inset 0 0 0 2rpx rgba(0, 122, 255, 0.08);
}

.choice-name {
  color: #1D1D1F;
  font-size: 29rpx;
  line-height: 1.28;
  font-weight: 850;
}

.choice-desc {
  margin-top: 12rpx;
  color: #6E6E73;
  font-size: 23rpx;
  line-height: 1.42;
}

.choice-check {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  background: #007AFF;
  font-size: 25rpx;
  line-height: 1;
  font-weight: 900;
}

.topic-tabs {
  display: flex;
  gap: 10rpx;
  padding: 6rpx;
  border: 2rpx solid #E5EAF2;
  border-radius: 24rpx;
  background: #F2F5F9;
}

.topic-tab {
  flex: 1;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6E6E73;
  font-size: 25rpx;
  font-weight: 800;
}

.topic-tab.active {
  color: #007AFF;
  background: #FFFFFF;
  box-shadow: 0 6rpx 18rpx rgba(17, 24, 39, 0.07);
}

.topic-picker { margin-top: 20rpx; }
.search-box { display: flex; align-items: center; gap: 14rpx; padding: 0 14rpx 0 22rpx; height: 82rpx; border-radius: 24rpx; background: #F5F5F7; }
.search-box input { flex: 1; height: 100%; font-size: 26rpx; color: #1D1D1F; }
.placeholder { color: #A1A1AA; }
.search-btn { height: 56rpx; padding: 0 22rpx; border-radius: 18rpx; background: #1D1D1F; color: #FFFFFF; font-size: 24rpx; font-weight: 700; display: flex; align-items: center; }

.topic-picked {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  border: 2rpx solid rgba(0, 122, 255, 0.34);
  background: #F4F9FF;
}

.topic-picked-mark {
  flex-shrink: 0;
  width: 46rpx;
  height: 46rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #B86E12;
  background: #FFF4E4;
  font-size: 26rpx;
  font-weight: 900;
}

.list-guide {
  margin: 20rpx 4rpx 8rpx;
  font-size: 23rpx;
  font-weight: 700;
  color: #8E8E93;
}

.topic-item { display: flex; align-items: center; gap: 18rpx; margin-top: 16rpx; padding: 22rpx; border-radius: 24rpx; border: 2rpx solid #ECECF0; background: #FFFFFF; }
.topic-item.selected { border-color: #007AFF; background: #F0F7FF; }
.topic-main { flex: 1; min-width: 0; }
.topic-title { font-size: 28rpx; line-height: 1.35; font-weight: 800; color: #1D1D1F; }
.topic-sub { margin-top: 6rpx; font-size: 23rpx; line-height: 1.45; color: #6E6E73; word-break: break-word; }
.topic-tags { margin-top: 8rpx; font-size: 22rpx; color: #8E8E93; }
.check { width: 40rpx; color: #007AFF; font-size: 30rpx; font-weight: 800; text-align: center; }

.custom-box { position: relative; margin-top: 20rpx; border-radius: 24rpx; background: #F5F5F7; padding: 20rpx; }
.custom-box textarea { width: 100%; height: 180rpx; font-size: 28rpx; line-height: 1.5; color: #1D1D1F; }
.counter { text-align: right; font-size: 22rpx; color: #8E8E93; }
.empty, .loading { padding: 36rpx 0; text-align: center; color: #8E8E93; font-size: 25rpx; }

.config-row {
  display: flex;
  gap: 18rpx;
  margin: 0 0 20rpx;
}
.quota-card {
  flex: 1;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.74);
  border: 2rpx solid #F0F0F4;
}
.quota-card text {
  display: block;
  color: #8E8E93;
  font-size: 22rpx;
}
.quota-card view {
  margin-top: 6rpx;
  color: #1D1D1F;
  font-size: 30rpx;
  font-weight: 800;
}
.start-btn { height: 92rpx; border-radius: 28rpx; background: #007AFF; color: #FFFFFF; font-size: 30rpx; font-weight: 800; }
.start-btn[disabled] { background: #C7C7CC; color: #FFFFFF; }
