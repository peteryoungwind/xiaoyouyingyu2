.daily-page {
  background: #F5F5F7;
}

.header-card {
  padding: 36rpx 32rpx;
  border-radius: 34rpx;
  background: #F3F8FF;
  border: 2rpx solid rgba(0, 122, 255, 0.14);
  box-shadow: 0 16rpx 40rpx rgba(0, 122, 255, 0.06);
  margin-bottom: 24rpx;
}

.header-label {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0.8rpx;
}

.header-title {
  margin-top: 22rpx;
  font-size: 48rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #1D1D1F;
}

.header-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #355D8A;
}

.tabs {
  display: flex;
  gap: 10rpx;
  padding: 8rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #ECECF0;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #6E6E73;
}

.tab-active {
  background: var(--primary);
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(0, 122, 255, 0.18);
}

.article-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.article-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  border: 2rpx solid #ECECF0;
  box-shadow: 0 12rpx 30rpx rgba(17, 24, 39, 0.04);
}

.article-cover {
  position: relative;
  width: 140rpx;
  height: 170rpx;
  flex: 0 0 140rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 18rpx;
  border-radius: 34rpx;
  color: #FFFFFF;
  box-sizing: border-box;
  box-shadow: 0 16rpx 32rpx rgba(0, 122, 255, 0.18);
}

.article-cover::before,
.article-cover::after {
  content: "";
  position: absolute;
  pointer-events: none;
}

.article-cover::before {
  left: 16rpx;
  right: 16rpx;
  top: 58rpx;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.42);
}

.article-cover::after {
  right: -34rpx;
  bottom: -34rpx;
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
}

.theme-0 {
  background: linear-gradient(160deg, rgba(0, 122, 255, 0.98), rgba(72, 144, 226, 0.76));
}

.theme-1 {
  background: linear-gradient(160deg, #FF9F0A, #007AFF 94%);
}

.theme-2 {
  background: linear-gradient(160deg, #1C1C1E, #0056CC 90%);
}

.cover-kicker,
.cover-title,
.cover-mark {
  position: relative;
  z-index: 1;
}

.cover-kicker {
  font-size: 18rpx;
  line-height: 1;
  font-weight: 900;
  letter-spacing: 1.2rpx;
  opacity: 0.88;
}

.cover-title {
  margin-top: auto;
  white-space: pre-line;
  font-size: 22rpx;
  line-height: 1.05;
  font-weight: 900;
}

.cover-mark {
  align-self: flex-start;
  min-width: 52rpx;
  height: 32rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: var(--primary);
  font-size: 18rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.article-main {
  flex: 1;
  min-width: 0;
}

.article-title {
  font-size: 31rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #1D1D1F;
  word-break: break-word;
}

.article-title-zh {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #6E6E73;
  word-break: break-word;
}

.article-arrow {
  flex: 0 0 auto;
  color: #C7C7CC;
  font-size: 48rpx;
  line-height: 1;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  width: 108rpx;
  height: 108rpx;
  border-radius: 34rpx;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 42rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1D1D1F;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #8E8E93;
  text-align: center;
  line-height: 1.6;
}

.retry-btn {
  margin-top: 28rpx;
  height: 72rpx;
  padding: 0 36rpx;
  border-radius: 22rpx;
  background: var(--primary);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #E5E5EA;
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-spinner-sm {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #E5E5EA;
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 12rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text,
.loading-more,
.no-more {
  font-size: 26rpx;
  color: #8E8E93;
}

.loading-text {
  margin-top: 16rpx;
}

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.no-more {
  text-align: center;
  padding: 32rpx 0;
}
