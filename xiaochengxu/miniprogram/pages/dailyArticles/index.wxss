.daily-page {
  background: #F5F5F7;
}

.header-card {
  padding: 36rpx 32rpx;
  border-radius: 34rpx;
  background: #F0FBF7;
  border: 2rpx solid rgba(15, 157, 112, 0.12);
  box-shadow: 0 16rpx 40rpx rgba(15, 157, 112, 0.06);
  margin-bottom: 24rpx;
}

.header-label {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #0F9D70;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0.8rpx;
}

.header-title {
  margin-top: 22rpx;
  font-size: 48rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #1D1D1F;
}

.header-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #4D6B60;
}

.tabs {
  display: flex;
  gap: 10rpx;
  padding: 8rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #ECECF0;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #6E6E73;
}

.tab-active {
  background: #0F9D70;
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(15, 157, 112, 0.18);
}

.article-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.article-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 2rpx solid #ECECF0;
  box-shadow: 0 12rpx 30rpx rgba(17, 24, 39, 0.04);
}

.article-main {
  flex: 1;
  min-width: 0;
}

.article-date {
  display: inline-flex;
  height: 38rpx;
  align-items: center;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #E8F7F2;
  color: #0F9D70;
  font-size: 20rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.article-title {
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #1D1D1F;
}

.article-title-zh {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #6E6E73;
}

.article-arrow {
  color: #C7C7CC;
  font-size: 48rpx;
  line-height: 1;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  width: 108rpx;
  height: 108rpx;
  border-radius: 34rpx;
  background: #F0FBF7;
  color: #0F9D70;
  font-size: 42rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1D1D1F;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #8E8E93;
  text-align: center;
  line-height: 1.6;
}

.retry-btn {
  margin-top: 28rpx;
  height: 72rpx;
  padding: 0 36rpx;
  border-radius: 22rpx;
  background: #0F9D70;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #E5E5EA;
  border-top-color: #0F9D70;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-spinner-sm {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #E5E5EA;
  border-top-color: #0F9D70;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 12rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text,
.loading-more,
.no-more {
  font-size: 26rpx;
  color: #8E8E93;
}

.loading-text {
  margin-top: 16rpx;
}

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.no-more {
  text-align: center;
  padding: 32rpx 0;
}
