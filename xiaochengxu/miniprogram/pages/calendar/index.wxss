/* Month Navigation */
.month-nav {
  display: flex; align-items: center; justify-content: space-between; padding: 24rpx 32rpx;
}
.nav-btn {
  width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 50%; background: var(--bg-input);
}
.nav-btn:active { background: var(--border); }
.nav-arrow { font-size: 32rpx; color: var(--text-primary); font-weight: 700; }
.month-title { font-size: 34rpx; font-weight: 700; color: var(--text-primary); }

/* Calendar Card */
.calendar-card { padding: 24rpx; }

/* Week Header */
.week-header { display: flex; margin-bottom: 16rpx; }
.week-day { flex: 1; text-align: center; }
.week-day-text { font-size: 24rpx; color: var(--text-secondary); font-weight: 600; }
.week-day-text.weekend { color: var(--error); }

/* Days Grid */
.days-grid { display: flex; flex-wrap: wrap; }
.day-cell {
  width: calc(100% / 7); display: flex; flex-direction: column;
  align-items: center; justify-content: center; padding: 12rpx 0;
  position: relative; min-height: 80rpx; box-sizing: border-box;
}
.day-cell.empty { pointer-events: none; }
.day-number {
  font-size: 28rpx; color: var(--text-primary); width: 60rpx; height: 60rpx;
  display: flex; align-items: center; justify-content: center; border-radius: 50%;
}
.day-cell.today .day-number { background: var(--primary-light); color: var(--primary); font-weight: 700; }
.day-cell.selected .day-number { background: var(--primary); color: #FFFFFF; font-weight: 700; }
.day-cell.has-topics .day-number { font-weight: 700; }
.topic-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--accent-gold); margin-top: 4rpx; }
.day-cell.selected .topic-dot { background: #FFFFFF; }

/* Topics Section */
.topics-section { margin-top: 8rpx; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.topic-count { font-size: 24rpx; color: var(--text-secondary); }
.topic-item { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 32rpx; }
.topic-title { font-size: 28rpx; color: var(--text-primary); flex: 1; margin-right: 16rpx; }
.topic-arrow { font-size: 36rpx; color: var(--text-hint); }

/* Hint */
.hint-card { padding: 48rpx 32rpx; }
.hint-text { font-size: 28rpx; color: var(--text-hint); }
.empty-text { color: var(--text-hint); font-size: 28rpx; padding: 24rpx 0; }
.loading-text { color: var(--text-hint); font-size: 28rpx; padding: 24rpx 0; }
