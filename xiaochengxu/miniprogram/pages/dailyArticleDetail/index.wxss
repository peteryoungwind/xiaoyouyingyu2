.detail-page {
  background: #F5F5F7;
}

.article-hero {
  padding: 36rpx 32rpx;
  border-radius: 34rpx;
  background: #FFFFFF;
  border: 2rpx solid #ECECF0;
  box-shadow: 0 16rpx 40rpx rgba(17, 24, 39, 0.05);
  margin-bottom: 24rpx;
}

.article-date {
  display: inline-flex;
  height: 40rpx;
  align-items: center;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #E8F7F2;
  color: #0F9D70;
  font-size: 20rpx;
  font-weight: 800;
  margin-bottom: 18rpx;
}

.article-title {
  font-size: 46rpx;
  line-height: 1.25;
  font-weight: 800;
  color: #1D1D1F;
}

.article-title-zh {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #6E6E73;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 28rpx;
}

.audio-btn,
.translate-btn {
  height: 70rpx;
  padding: 0 28rpx;
  border-radius: 22rpx;
  font-size: 25rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.audio-btn {
  background: #0F9D70;
  color: #FFFFFF;
}

.translate-btn {
  background: #F2F2F7;
  color: #3A3A3C;
}

.translate-btn-on {
  background: #E8F7F2;
  color: #0F9D70;
}

.content-card,
.study-section {
  border-radius: 30rpx;
  background: #FFFFFF;
  border: 2rpx solid #ECECF0;
  box-shadow: 0 12rpx 30rpx rgba(17, 24, 39, 0.04);
  margin-bottom: 24rpx;
}

.content-card {
  padding: 32rpx;
}

.paragraph {
  padding-bottom: 30rpx;
  margin-bottom: 30rpx;
  border-bottom: 2rpx solid #F2F2F7;
}

.paragraph:last-child {
  padding-bottom: 0;
  margin-bottom: 0;
  border-bottom: none;
}

.paragraph-en {
  font-size: 31rpx;
  line-height: 1.85;
  color: #1D1D1F;
}

.paragraph-zh {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #F5F7FA;
  font-size: 27rpx;
  line-height: 1.75;
  color: #5D626A;
}

.study-section {
  padding: 30rpx;
}

.section-title {
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 800;
  color: #1D1D1F;
  margin-bottom: 20rpx;
}

.summary-text {
  white-space: pre-wrap;
  font-size: 28rpx;
  line-height: 1.75;
  color: #5D626A;
}

.study-item {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #F8F8FA;
  margin-bottom: 16rpx;
}

.study-item:last-child {
  margin-bottom: 0;
}

.study-title {
  font-size: 29rpx;
  line-height: 1.45;
  font-weight: 800;
  color: #1D1D1F;
}

.study-zh {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #6E6E73;
}

.study-example {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #0F9D70;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  width: 108rpx;
  height: 108rpx;
  border-radius: 34rpx;
  background: #FFF2F2;
  color: #FF3B30;
  font-size: 42rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1D1D1F;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #8E8E93;
  text-align: center;
  line-height: 1.6;
}

.retry-btn {
  margin-top: 28rpx;
  height: 72rpx;
  padding: 0 36rpx;
  border-radius: 22rpx;
  background: #0F9D70;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #E5E5EA;
  border-top-color: #0F9D70;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8E8E93;
}
