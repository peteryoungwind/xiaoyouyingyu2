<view class="page-container safe-bottom topics-page">
  <view class="topics-hero">
    <view class="topics-title">主题</view>
    <view class="topics-subtitle">搜索、筛选、按日期浏览全部练习主题</view>
    <view class="search-panel">
      <view class="search-input-wrap">
        <input class="search-input" placeholder="搜索主题关键词" placeholder-class="search-placeholder" value="{{keyword}}" bindinput="onSearchInput" bindconfirm="onSearch" />
      </view>
      <view class="filter-panel">
        <view class="filter-grid">
          <view class="filter-cell">
            <view class="filter-pill filter-pill-all {{selectedTag === '' ? 'filter-pill-active filter-pill-all-active' : ''}}" bindtap="onTagTap" data-tag="">
              全部
            </view>
          </view>
          <view wx:for="{{tags}}" wx:key="name" class="filter-cell">
            <view
              class="filter-pill {{selectedTag === item.name ? 'filter-pill-active' : ''}}"
              bindtap="onTagTap"
              data-tag="{{item.name}}"
              style="background: {{selectedTag === item.name ? item.activeBg : item.bg}}; color: {{selectedTag === item.name ? item.activeColor : item.color}}; border-color: {{selectedTag === item.name ? item.activeBorder : item.border}};"
            >
              {{item.name}}
            </view>
          </view>
        </view>
      </view>
      <view class="calendar-entry" bindtap="goToCalendar">
        <text class="calendar-entry-text">按日历浏览本月主题</text>
        <view class="calendar-entry-btn">进入日历</view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-text">加载中...</view>
  </view>

  <view wx:elif="{{topics.length === 0}}" class="empty-wrap">
    <view class="empty-text">暂无主题</view>
  </view>

  <view wx:else class="topic-list">
    <view wx:for="{{topics}}" wx:key="id" class="topic-card" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="topic-main">
        <view class="topic-copy">
          <view class="topic-title">{{item.titleZh || item.title}}</view>
          <view class="topic-meta">
            <text class="topic-date">{{item.eventDate}}</text>
            <text class="topic-divider" wx:if="{{item.questionCountText}}">·</text>
            <text class="topic-questions" wx:if="{{item.questionCountText}}">{{item.questionCountText}}</text>
          </view>
          <view class="topic-tags" wx:if="{{item.tagList.length > 0}}">
            <text wx:for="{{item.tagList}}" wx:key="*this" wx:for-item="tag" class="topic-tag">{{tag}}</text>
          </view>
        </view>
        <view class="detail-btn">详情</view>
      </view>
    </view>
  </view>

  <view wx:if="{{loadingMore}}" class="loading-wrap"><view class="loading-text">加载更多...</view></view>
  <view wx:if="{{!loading && !loadingMore && page >= totalPages && topics.length > 0}}" class="load-more-wrap">
    <view class="load-more-btn disabled">没有更多数据</view>
  </view>

  <view wx:if="{{!isLoggedIn}}" class="guest-tip">
    游客可浏览主题，登录后可使用关键词搜索
  </view>
</view>
