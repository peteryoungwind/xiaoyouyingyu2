.search-bar { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.search-input-wrap { flex: 1; background: #FFFFFF; border-radius: 16rpx; padding: 0 24rpx; height: 76rpx; display: flex; align-items: center; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.search-input-wrap input { flex: 1; height: 100%; font-size: 28rpx; }
.search-btn { background: #4A90D9; color: #fff; padding: 0 24rpx; height: 76rpx; line-height: 76rpx; border-radius: 16rpx; font-size: 26rpx; }
.calendar-btn { width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; background: #fff; border-radius: 16rpx; font-size: 36rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }

.tags-scroll { margin-bottom: 20rpx; white-space: nowrap; }
.tags-row { display: inline-flex; gap: 12rpx; padding: 4rpx 0; }

.topic-card { padding: 24rpx 32rpx; }
.topic-title { font-size: 30rpx; font-weight: 500; }
.topic-title-zh { font-size: 26rpx; color: #6C7A8D; margin-top: 8rpx; }
.topic-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; }
.topic-date { font-size: 24rpx; color: #B0B8C4; }
.topic-tags { display: flex; flex-wrap: wrap; }

.loading-wrap { text-align: center; padding: 48rpx 0; }
.loading-text { color: #B0B8C4; font-size: 26rpx; }
.end-text { font-size: 24rpx; }

.empty-wrap { text-align: center; padding: 120rpx 0; }
.empty-text { color: #B0B8C4; font-size: 28rpx; }
