.topics-page {
  background: #F5F5F7;
}

.topics-hero {
  position: relative;
  padding-top: 8rpx;
  margin-bottom: 28rpx;
}

.topics-hero::after {
  content: '';
  position: absolute;
  right: -90rpx;
  top: -120rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: rgba(0, 122, 255, 0.10);
  filter: blur(4rpx);
  pointer-events: none;
}

.topics-title {
  position: relative;
  z-index: 1;
  font-size: 64rpx;
  line-height: 1.12;
  font-weight: 800;
  color: #1D1D1F;
}

.topics-subtitle {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #6E6E73;
}

.search-panel {
  position: relative;
  z-index: 1;
  margin-top: 32rpx;
}

.search-input-wrap {
  height: 100rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 2rpx solid #E5E5EA;
  border-radius: 34rpx;
  box-shadow: 0 14rpx 36rpx rgba(17, 24, 39, 0.04);
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
  color: #1D1D1F;
}

.search-placeholder {
  color: #A1A1AA;
}

.filter-panel {
  margin-top: 24rpx;
  padding: 24rpx 22rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 2rpx solid rgba(229, 229, 234, 0.92);
  box-shadow: 0 14rpx 36rpx rgba(17, 24, 39, 0.04);
  backdrop-filter: blur(10rpx);
}

.filter-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.filter-cell {
  width: 20%;
  padding: 8rpx;
  box-sizing: border-box;
}

.filter-pill {
  width: 100%;
  min-height: 76rpx;
  padding: 12rpx 6rpx;
  border-radius: 24rpx;
  border: 2rpx solid transparent;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.filter-pill-all {
  background: #EEF5FF;
  border-color: #CFE0FF;
  color: #4F7BFF;
}

.filter-pill-active {
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(17, 24, 39, 0.08);
}

.filter-pill-all-active {
  background: linear-gradient(135deg, #007AFF, #4DA3FF);
  border-color: transparent;
  color: #FFFFFF;
}

.calendar-entry {
  margin-top: 28rpx;
  min-height: 92rpx;
  padding: 0 14rpx 0 30rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  border: 2rpx solid #E5E5EA;
  box-shadow: 0 14rpx 36rpx rgba(17, 24, 39, 0.04);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.calendar-entry-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #6E6E73;
}

.calendar-entry-btn {
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #EAF3FF;
  border: 2rpx solid #BFDBFE;
  color: #007AFF;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.topic-submit-entry {
  margin-top: 20rpx;
  min-height: 106rpx;
  padding: 22rpx 18rpx 22rpx 28rpx;
  border-radius: 30rpx;
  background: #FFF8E8;
  border: 2rpx solid rgba(245, 158, 11, 0.18);
  box-shadow: 0 12rpx 30rpx rgba(245, 158, 11, 0.05);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.topic-submit-entry:active {
  transform: scale(0.99);
}

.topic-submit-copy {
  flex: 1;
  min-width: 0;
}

.topic-submit-title {
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #1D1D1F;
}

.topic-submit-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #8A5A00;
}

.topic-submit-btn {
  height: 62rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(245, 158, 11, 0.26);
  color: #B7791F;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.topic-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.topic-card {
  background: #FFFFFF;
  border-radius: 34rpx;
  padding: 34rpx 32rpx;
  border: 2rpx solid #E5E5EA;
  box-shadow: 0 16rpx 40rpx rgba(17, 24, 39, 0.04);
}

.topic-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.topic-copy {
  flex: 1;
  min-width: 0;
}

.topic-title {
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #1D1D1F;
}

.topic-meta {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  font-size: 22rpx;
  color: #6E6E73;
}

.topic-date,
.topic-divider,
.topic-questions {
  color: #6E6E73;
}

.topic-tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.topic-tag {
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #EAF3FF;
  border: 2rpx solid #D8E8FF;
  color: #007AFF;
  font-size: 22rpx;
  line-height: 44rpx;
  font-weight: 600;
}

.detail-btn {
  width: 126rpx;
  height: 70rpx;
  border-radius: 999rpx;
  background: #F4F8FF;
  border: 2rpx solid #D8E8FF;
  color: #007AFF;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.loading-wrap {
  text-align: center;
  padding: 60rpx 0;
}

.loading-text {
  color: #8E8E93;
  font-size: 26rpx;
}

.empty-wrap {
  text-align: center;
  padding: 140rpx 0;
}

.empty-text {
  color: #8E8E93;
  font-size: 28rpx;
}

.load-more-wrap {
  padding: 36rpx 0 20rpx;
}

.load-more-btn {
  height: 100rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 2rpx solid #E5E5EA;
  color: #6E6E73;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(17, 24, 39, 0.03);
}

.load-more-btn.disabled {
  color: #8E8E93;
}

.guest-tip {
  margin-top: 18rpx;
  height: 96rpx;
  padding: 0 30rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  border: 2rpx solid #E5E5EA;
  color: #6E6E73;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 12rpx 30rpx rgba(17, 24, 39, 0.03);
}
