.shadowing-page {
  background: #F5F5F7;
}

.header-card {
  padding: 36rpx 32rpx;
  border-radius: 34rpx;
  background: #EEF5FF;
  border: 2rpx solid rgba(0, 122, 255, 0.12);
  box-shadow: 0 16rpx 40rpx rgba(0, 122, 255, 0.06);
  margin-bottom: 24rpx;
}

.header-label {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #007AFF;
  font-size: 20rpx;
  font-weight: 800;
}

.header-title {
  margin-top: 22rpx;
  font-size: 48rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #1D1D1F;
}

.header-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #50657F;
}

.hero-card {
  padding: 30rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  border: 2rpx solid #ECECF0;
  box-shadow: 0 14rpx 34rpx rgba(17, 24, 39, 0.04);
  margin-bottom: 24rpx;
}

.hero-top {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.hero-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: #007AFF;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 900;
}

.hero-kicker {
  font-size: 22rpx;
  color: #6E6E73;
  font-weight: 700;
}

.hero-title {
  margin-top: 4rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #1D1D1F;
}

.hero-copy {
  margin-top: 18rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #6E6E73;
}

.tabs {
  display: flex;
  gap: 10rpx;
  padding: 8rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #ECECF0;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #6E6E73;
}

.tab-active {
  background: #007AFF;
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(0, 122, 255, 0.18);
}

.lesson-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.lesson-card {
  display: flex;
  gap: 22rpx;
  padding: 22rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  border: 2rpx solid #ECECF0;
  box-shadow: 0 12rpx 30rpx rgba(17, 24, 39, 0.04);
}

.cover-wrap {
  position: relative;
  width: 178rpx;
  height: 136rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #DCEBFF;
  flex-shrink: 0;
}

.cover-image,
.cover-placeholder {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #007AFF;
  font-size: 42rpx;
  font-weight: 900;
}

.play-badge {
  position: absolute;
  left: 12rpx;
  bottom: 12rpx;
  height: 34rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(29, 29, 31, 0.72);
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}

.lesson-main {
  flex: 1;
  min-width: 0;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.chip {
  max-width: 220rpx;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #EEF5FF;
  color: #007AFF;
  font-size: 19rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chip.green {
  background: #E8F7F2;
  color: #0F9D70;
}

.lesson-title {
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #1D1D1F;
}

.lesson-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: #6E6E73;
}

.lesson-footer {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  font-size: 21rpx;
  color: #8E8E93;
}

.arrow {
  color: #C7C7CC;
  font-size: 42rpx;
  line-height: 1;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  width: 108rpx;
  height: 108rpx;
  border-radius: 34rpx;
  background: #EEF5FF;
  color: #007AFF;
  font-size: 38rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1D1D1F;
  margin-bottom: 12rpx;
  text-align: center;
}

.empty-desc {
  font-size: 26rpx;
  color: #8E8E93;
  text-align: center;
  line-height: 1.6;
}

.retry-btn {
  margin-top: 28rpx;
  height: 72rpx;
  padding: 0 36rpx;
  border-radius: 22rpx;
  background: #007AFF;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #E5E5EA;
  border-top-color: #007AFF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-spinner-sm {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #E5E5EA;
  border-top-color: #007AFF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 12rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text,
.loading-more,
.no-more {
  font-size: 26rpx;
  color: #8E8E93;
}

.loading-text {
  margin-top: 16rpx;
}

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.no-more {
  text-align: center;
  padding: 32rpx 0;
}
