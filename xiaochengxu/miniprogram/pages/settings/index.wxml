<view class="page-container safe-bottom">

  <!-- Membership info card -->
  <view class="card membership-card {{membershipActive ? 'membership-active' : ''}}">
    <view class="card-title">会员信息</view>
    <view class="flex justify-between items-center mt-16">
      <text class="detail-label">状态</text>
      <view class="membership-status status-{{membershipStatus}}">{{membershipStatusLabel || '未开通'}}</view>
    </view>
    <view wx:if="{{membershipExpireAt}}" class="flex justify-between items-center mt-16">
      <text class="detail-label">{{membershipActive ? '到期时间' : '过期时间'}}</text>
      <text class="detail-value {{!membershipActive ? 'expired-text' : ''}}">{{membershipExpireAt}}</text>
    </view>
    <view wx:if="{{membershipActive && remainingDays > 0}}" class="flex justify-between items-center mt-16">
      <text class="detail-label">剩余天数</text>
      <text class="detail-value remain-days">{{remainingDays}} 天</text>
    </view>
  </view>

  <!-- Not member: contact info -->
  <view wx:if="{{!isMember}}" class="card">
    <view class="card-title">开通会员</view>
    <view class="member-promo">
      <text class="promo-text">开通会员即可使用学习中心全部功能，包括AI热身、词汇、表达模板、练习任务和AI点评。</text>
    </view>

    <view class="contact-section mt-24">
      <view class="contact-item">
        <text class="contact-text">联系人：西柚</text>
      </view>
      <view class="contact-item">
        <text class="contact-text">微信：</text>
        <text class="contact-value selectable" selectable="true">915981048</text>
      </view>
    </view>
  </view>

  <!-- Redeem entry -->
  <view class="card menu-card">
    <view class="menu-item" bindtap="goToRedeem">
      <view class="menu-icon">🎫</view>
      <view class="menu-text">卡密兑换</view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <!-- Username entry -->
  <view class="card menu-card">
    <view class="menu-item" bindtap="openUsernameModal">
      <view class="menu-text-group">
        <view class="menu-text">修改用户名</view>
        <view class="menu-subtext">当前用户名：{{originalUsername || '未设置'}}</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <!-- Password entry -->
  <view class="card menu-card">
    <view class="menu-item" bindtap="openPasswordModal">
      <view class="menu-text-group">
        <view class="menu-text">{{hasPassword ? '修改密码' : '设置密码'}}</view>
        <view class="menu-subtext">{{hasPassword ? '点击后弹窗修改密码' : '设置后可使用账号密码登录PC端'}}</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <!-- Username modal -->
  <view wx:if="{{showUsernameModal}}" class="modal-mask" bindtap="closeUsernameModal">
    <view class="modal-panel" catchtap="stopModalPropagation">
      <view class="modal-title">修改用户名</view>
      <view class="form-group mt-24">
        <view class="form-label">新用户名</view>
        <view class="input-wrapper">
          <input
            type="text"
            placeholder="请输入3-50位用户名"
            value="{{username}}"
            bindinput="onUsernameInput"
          />
        </view>
      </view>
      <view class="modal-actions">
        <button class="modal-btn modal-btn-secondary" bindtap="closeUsernameModal">取消</button>
        <button class="modal-btn modal-btn-primary" bindtap="onChangeUsername" disabled="{{submittingUsername}}">{{submittingUsername ? '提交中...' : '确认修改'}}</button>
      </view>
    </view>
  </view>

  <!-- Password modal -->
  <view wx:if="{{showPasswordModal}}" class="modal-mask" bindtap="closePasswordModal">
    <view class="modal-panel" catchtap="stopModalPropagation">
      <view class="modal-title">{{hasPassword ? '修改密码' : '设置密码'}}</view>

      <view wx:if="{{hasPassword}}" class="form-group mt-24">
        <view class="form-label">原密码</view>
        <view class="input-wrapper">
          <input
            type="text"
            password
            placeholder="请输入原密码"
            value="{{oldPassword}}"
            bindinput="onOldPasswordInput"
          />
        </view>
      </view>

      <view class="form-group {{hasPassword ? '' : 'mt-24'}}">
        <view class="form-label">新密码</view>
        <view class="input-wrapper">
          <input
            type="text"
            password
            placeholder="至少6位"
            value="{{newPassword}}"
            bindinput="onNewPasswordInput"
          />
        </view>
      </view>

      <view class="form-group">
        <view class="form-label">确认新密码</view>
        <view class="input-wrapper">
          <input
            type="text"
            password
            placeholder="再次输入新密码"
            value="{{confirmPassword}}"
            bindinput="onConfirmPasswordInput"
          />
        </view>
      </view>

      <view class="modal-actions">
        <button class="modal-btn modal-btn-secondary" bindtap="closePasswordModal">取消</button>
        <button class="modal-btn modal-btn-primary" bindtap="onChangePassword" disabled="{{submitting}}">{{submitting ? '提交中...' : (hasPassword ? '确认修改' : '确认设置')}}</button>
      </view>
    </view>
  </view>

</view>
