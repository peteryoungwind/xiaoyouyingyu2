/* Empty state */
.empty-state {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; padding: 120rpx 48rpx;
}
.empty-icon { font-size: 96rpx; margin-bottom: 32rpx; }
.empty-title { font-size: 36rpx; font-weight: 700; color: var(--text-primary); margin-bottom: 16rpx; }
.empty-desc { font-size: 28rpx; color: var(--text-secondary); text-align: center; line-height: 1.6; }

/* Stats card */
.word-practice-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  background: #E8F5E9;
  border: 2rpx solid rgba(52, 199, 89, 0.18);
  border-radius: 30rpx;
  padding: 30rpx;
  margin-bottom: 28rpx;
}

.word-practice-title {
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 800;
  color: #1D1D1F;
}

.word-practice-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #4D6B52;
}

.word-practice-btn {
  height: 64rpx;
  padding: 0 26rpx;
  border-radius: 20rpx;
  background: #1B7F3A;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.stats-card {
  background: #FFFFFF; border-radius: 28rpx; padding: 40rpx;
  margin-bottom: 32rpx; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.stat-block { flex: 1; display: flex; flex-direction: column; align-items: center; text-align: center; }
.stat-label { font-size: 22rpx; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; }
.stat-value { font-size: 64rpx; font-weight: 800; color: var(--primary); line-height: 1.2; }
.stat-value-gold { color: var(--accent-gold); }
.stat-unit { font-size: 26rpx; font-weight: 600; color: var(--text-secondary); margin-left: 4rpx; }
.stat-divider { width: 2rpx; height: 80rpx; background: var(--border); }

/* Header */
.page-header { margin-bottom: 32rpx; }
.page-header-sub { font-size: 24rpx; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 2rpx; }
.page-header-title { font-size: 56rpx; font-weight: 800; letter-spacing: -1rpx; }

/* Membership card */
.membership-card { width: 100%; text-align: left; }
.contact-item { display: flex; align-items: flex-start; padding: 16rpx 0; border-bottom: 1rpx solid var(--border); }
.contact-item:last-child { border-bottom: none; }
.contact-label { font-size: 26rpx; color: var(--text-secondary); width: 120rpx; flex-shrink: 0; }
.contact-value { font-size: 28rpx; color: var(--text-primary); flex: 1; }
.contact-value.selectable { color: var(--primary); }

/* Search bar */
.search-bar { margin-bottom: 24rpx; }
.search-input-wrapper {
  position: relative;
  height: 100rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 2rpx solid #E5E5EA;
  border-radius: 34rpx;
  box-shadow: 0 14rpx 36rpx rgba(17, 24, 39, 0.04);
}
.search-input {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
  color: #1D1D1F;
}
.search-placeholder { color: #A1A1AA; }
.clear-btn {
  padding: 8rpx 0 8rpx 16rpx;
  color: var(--text-hint);
  font-size: 28rpx;
  flex-shrink: 0;
}

/* Tag filter */
.filter-panel {
  margin-bottom: 24rpx;
  padding: 24rpx 22rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 2rpx solid rgba(229, 229, 234, 0.92);
  box-shadow: 0 14rpx 36rpx rgba(17, 24, 39, 0.04);
  backdrop-filter: blur(10rpx);
}

.filter-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.filter-cell {
  width: 20%;
  padding: 8rpx;
  box-sizing: border-box;
}

.filter-pill {
  width: 100%;
  min-height: 76rpx;
  padding: 12rpx 6rpx;
  border-radius: 24rpx;
  border: 2rpx solid transparent;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.filter-pill-all {
  background: #EEF5FF;
  border-color: #CFE0FF;
  color: #4F7BFF;
}

.filter-pill-active {
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(17, 24, 39, 0.08);
}

.filter-pill-all-active {
  background: linear-gradient(135deg, #007AFF, #4DA3FF);
  border-color: transparent;
  color: #FFFFFF;
}

/* Topic card */
.topic-card { position: relative; }
.topic-title { font-size: 32rpx; font-weight: 600; color: var(--text-primary); line-height: 1.4; }
.topic-title-zh { font-size: 26rpx; color: var(--text-secondary); margin-top: 8rpx; }
.topic-meta { margin-top: 16rpx; }
.topic-date { font-size: 24rpx; color: var(--text-hint); }
.topic-tags { margin-top: 12rpx; display: flex; flex-wrap: wrap; }

/* Section title */
.section-title { font-size: 36rpx; font-weight: 700; margin-bottom: 20rpx; padding: 0 4rpx; }

/* Loading */
.loading-container { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.loading-spinner {
  width: 64rpx; height: 64rpx; border: 4rpx solid var(--border);
  border-top-color: var(--primary); border-radius: 50%; animation: spin 0.8s linear infinite;
}
.loading-spinner-sm {
  width: 36rpx; height: 36rpx; border: 3rpx solid var(--border);
  border-top-color: var(--primary); border-radius: 50%; animation: spin 0.8s linear infinite; margin-right: 12rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 26rpx; color: var(--text-secondary); margin-top: 16rpx; }
.loading-more { display: flex; align-items: center; justify-content: center; padding: 32rpx 0; font-size: 26rpx; color: var(--text-secondary); }
.no-more { text-align: center; padding: 32rpx 0; font-size: 26rpx; color: var(--text-hint); }
