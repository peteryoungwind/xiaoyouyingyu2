<view class="empty-container">
  <image class="empty-icon" wx:if="{{icon}}" src="{{icon}}" mode="aspectFit"></image>
  <view class="empty-icon-default" wx:else>
    <text class="empty-icon-text">!</text>
  </view>
  <text class="empty-text">{{text}}</text>
  <button class="btn btn-primary btn-sm empty-btn" wx:if="{{buttonText}}" bindtap="onButtonTap">{{buttonText}}</button>
</view>
