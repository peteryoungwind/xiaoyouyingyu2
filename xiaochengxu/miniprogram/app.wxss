/* ===== iOS-style 全局设计规范 ===== */
page {
  --primary: #007AFF;
  --primary-light: #E5F1FF;
  --primary-dark: #0056CC;
  --secondary: #8E8E93;
  --accent-gold: #FF9500;
  --accent-gold-light: #FFF8EC;
  --success: #34C759;
  --error: #FF3B30;
  --warning: #FFCC00;
  --text-primary: #1C1C1E;
  --text-secondary: #8E8E93;
  --text-hint: #C7C7CC;
  --bg-page: #F2F2F7;
  --bg-card: #FFFFFF;
  --bg-input: #F2F2F7;
  --border: #E5E5EA;

  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: var(--text-primary);
  background-color: var(--bg-page);
  line-height: 1.5;
}

/* 通用容器 */
.page-container {
  padding: 24rpx 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  padding: 0 32rpx;
  line-height: 88rpx;
}

.btn::after { border: none; }

.btn-primary {
  background: var(--primary);
  color: #FFFFFF;
}

.btn-primary:active { background: var(--primary-dark); }

.btn-secondary {
  background: var(--primary-light);
  color: var(--primary);
}

.btn-gold {
  background: linear-gradient(135deg, #FF9500, #FFCC00);
  color: #FFFFFF;
}

.btn-outline {
  background: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary);
}

.btn-sm {
  height: 64rpx;
  font-size: 26rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  border-radius: 32rpx;
}

.btn-block { width: 100%; }
.btn-disabled { opacity: 0.5; }

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-light);
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.tag-active {
  background: var(--primary);
  color: #FFFFFF;
}

/* 输入框 */
.input-wrapper {
  background: var(--bg-input);
  border-radius: 20rpx;
  padding: 0 24rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid transparent;
}

.input-wrapper-focus {
  border-color: var(--primary);
  background: #FFFFFF;
}

.input-wrapper input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
}

/* flex */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-wrap { flex-wrap: wrap; }
.items-center { align-items: center; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.flex-1 { flex: 1; }

.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mb-32 { margin-bottom: 32rpx; }

.text-center { text-align: center; }

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
