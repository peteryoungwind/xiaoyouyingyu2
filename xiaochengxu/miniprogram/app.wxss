/* ===== 全局设计规范 ===== */
page {
  --primary: #4A90D9;
  --primary-light: #E8F0FE;
  --primary-dark: #3A78C2;
  --secondary: #6C7A8D;
  --accent-gold: #F5A623;
  --accent-gold-light: #FFF8EC;
  --success: #52C41A;
  --error: #FF4D4F;
  --warning: #FAAD14;
  --text-primary: #1A1A2E;
  --text-secondary: #6C7A8D;
  --text-hint: #B0B8C4;
  --bg-page: #F5F7FA;
  --bg-card: #FFFFFF;
  --bg-input: #F5F7FA;
  --border: #E8ECF1;

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: var(--text-primary);
  background-color: var(--bg-page);
  line-height: 1.6;
}

/* 通用容器 */
.page-container {
  padding: 24rpx 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 16rpx;
}

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  padding: 0 32rpx;
  line-height: 88rpx;
}

.btn::after { border: none; }

.btn-primary {
  background: #4A90D9;
  color: #FFFFFF;
}

.btn-primary:active { background: #3A78C2; }

.btn-secondary {
  background: #E8F0FE;
  color: #4A90D9;
}

.btn-gold {
  background: linear-gradient(135deg, #F5A623, #F7C948);
  color: #FFFFFF;
}

.btn-outline {
  background: transparent;
  color: #4A90D9;
  border: 2rpx solid #4A90D9;
}

.btn-sm {
  height: 64rpx;
  font-size: 26rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
}

.btn-block { width: 100%; }
.btn-disabled { opacity: 0.5; }

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #4A90D9;
  background: #E8F0FE;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.tag-active {
  background: #4A90D9;
  color: #FFFFFF;
}

/* 输入框 */
.input-wrapper {
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid transparent;
}

.input-wrapper-focus {
  border-color: #4A90D9;
  background: #FFFFFF;
}

.input-wrapper input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
}

/* flex */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-wrap { flex-wrap: wrap; }
.items-center { align-items: center; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.flex-1 { flex: 1; }

.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mb-32 { margin-bottom: 32rpx; }

.text-center { text-align: center; }

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
