  return (
    <div className="h-full bg-white flex flex-col px-10 animate-in fade-in duration-700">
      <div className="flex-[1.8] flex flex-col items-center justify-center pt-6">
        <div className="w-28 h-28 bg-gradient-to-br from-[#007AFF] to-[#5856D6] rounded-[32px] flex items-center justify-center shadow-2xl shadow-blue-100 mb-8 relative">
          <BookOpen size={56} className="text-white" />
          <div className="absolute -right-2 -top-2 w-10 h-10 bg-amber-400 rounded-full border-4 border-white flex items-center justify-center shadow-lg">
            <Sparkles size={18} className="text-white" />
          </div>
        </div>
        <h1 className="text-4xl font-black tracking-tight text-gray-900">小柚英语</h1>
        <p className="text-[#8E8E93] text-base mt-4 font-medium opacity-80 tracking-wide">地道口语，AI 轻松陪练</p>
      </div>

      <div className="flex-1 flex flex-col justify-end pb-24 space-y-10">
        <div className="relative">
          {showTip && (
            <div className="absolute -top-14 left-1/2 -translate-x-1/2 bg-gray-900 text-white text-xs px-4 py-2 rounded-xl animate-bounce whitespace-nowrap shadow-xl">
              请先勾选同意协议
              <div className="absolute -bottom-1 left-1/2 -translate-x-1/2 w-2 h-2 bg-gray-900 rotate-45"></div>
            </div>
          )}
          <button
            onClick={handleWechatLogin}
            className={`w-full h-16 rounded-[20px] font-bold text-xl flex items-center justify-center gap-4 transition-all active:scale-[0.97] shadow-2xl tracking-wide ${
              agree
              ? 'bg-[#07C160] text-white shadow-green-200 ring-4 ring-green-50'
              : 'bg-gray-100 text-gray-400 shadow-none'
            }`}
          >
            <MessageSquare size={28} fill={agree ? "white" : "currentColor"} className="opacity-90" />
            微信一键登录
          </button>
        </div>

        <div className="flex items-start gap-4 px-2">
          <div
            onClick={() => setAgree(!agree)}
            className={`mt-1 w-6 h-6 rounded-full border-2 flex items-center justify-center transition-all cursor-pointer shrink-0 ${
              agree ? 'bg-[#007AFF] border-[#007AFF]' : 'border-gray-200 bg-gray-50'
            }`}
          >
            {agree && <CheckCircle2 size={14} className="text-white" strokeWidth={4} />}
          </div>
          <div className="text-[13px] text-[#8E8E93] leading-relaxed select-none py-0.5" onClick={() => setAgree(!agree)}>
            我已阅读并同意 <span className="text-[#007AFF] font-bold underline underline-offset-4 decoration-blue-100">《用户服务协议》</span> 与 <span className="text-[#007AFF] font-bold underline underline-offset-4 decoration-blue-100">《隐私政策》</span>
            <p className="mt-1 opacity-60 text-[11px]">首次登录将为您自动创建账号并开通试用会员</p>
          </div>
        </div>
      </div>
    </div>
  );
};

