import React, { useState, useEffect } from 'react';
import {
  User,
  Search,
  Calendar,
  LayoutDashboard,
  ChevronLeft,
  ChevronRight,
  MessageSquare,
  Clock,
  Zap,
  CheckCircle2,
  Mic,
  Volume2,
  Sparkles,
  RefreshCw,
  Award,
  Briefcase,
  Plane,
  Coffee,
  Utensils,
  ShieldCheck,
  Smartphone,
  BookOpen,
  Settings
} from 'lucide-react';

const App = () => {
  const [activeTab, setActiveTab] = useState('home');
  const [currentPage, setCurrentPage] = useState('login');
  const [studyStep, setStudyStep] = useState(0);
  const [userStatus, setUserStatus] = useState({ isVip: false, isLoggedIn: false });

  const navigateTo = (page) => {
    setCurrentPage(page);
    if (page === 'study') setStudyStep(0);
  };

  const handleLoginSuccess = () => {
    setUserStatus({ ...userStatus, isLoggedIn: true });
    setCurrentPage('index');
    setActiveTab('home');
  };

  const renderPage = () => {
    if (currentPage === 'login') {
      return <LoginPage onLogin={handleLoginSuccess} />;
    }

    if (currentPage === 'index') {
      switch (activeTab) {
        case 'home': return <HomePage onTopicClick={() => navigateTo('detail')} user={userStatus} />;
        case 'learn': return <LearningCenterPage user={userStatus} onContinue={() => navigateTo('study')} />;
        case 'calendar': return <div className="p-10 text-center text-gray-400">日历功能建设中</div>;
        case 'profile': return <ProfilePage user={userStatus} onLogout={() => setCurrentPage('login')} />;
        default: return <HomePage onTopicClick={() => navigateTo('detail')} />;
      }
    }

    switch (currentPage) {
      case 'detail': return <DetailPage onBack={() => navigateTo('index')} onStart={() => navigateTo('study')} />;
      case 'study': return <StudyStageFlow step={studyStep} setStep={setStudyStep} onExit={() => navigateTo('index')} />;
      default: return <HomePage onTopicClick={() => navigateTo('detail')} />;
    }
  };

  return (
    <div className="flex flex-col h-screen bg-[#F8F9FA] text-[#1C1C1E] font-sans overflow-hidden max-w-md mx-auto border-x border-gray-100 shadow-2xl relative">
      {/* 统一顶部状态栏 */}
      <div className="h-10 flex justify-between items-center px-6 text-xs font-bold bg-white/80 backdrop-blur-md shrink-0 z-50">
        <span>9:41</span>
        <div className="flex gap-1.5 items-center">
          <div className="w-5 h-2.5 border border-black/20 rounded-sm relative">
             <div className="absolute left-0 top-0 h-full bg-black w-3/4 rounded-sm"></div>
          </div>
          <div className="w-3 h-3 bg-black rounded-full"></div>
        </div>
      </div>

      <div className="flex-1 overflow-y-auto">
        {renderPage()}
      </div>

      {/* 统一底部导航栏 */}
      {currentPage === 'index' && (
        <div className="h-20 bg-white/95 backdrop-blur-md border-t border-gray-100 flex justify-around items-center px-2 shrink-0 pb-4">
          <TabItem active={activeTab === 'home'} icon={<Search size={22} />} label="探索" onClick={() => setActiveTab('home')} />
          <TabItem active={activeTab === 'learn'} icon={<LayoutDashboard size={22} />} label="学习中心" onClick={() => setActiveTab('learn')} />
          <TabItem active={activeTab === 'calendar'} icon={<Calendar size={22} />} label="打卡" onClick={() => setActiveTab('calendar')} />
          <TabItem active={activeTab === 'profile'} icon={<User size={22} />} label="我的" onClick={() => setActiveTab('profile')} />
        </div>
      )}
    </div>
  );
};

// --- P11 登录页组件 (优化按钮尺寸与视觉) ---
const LoginPage = ({ onLogin }) => {
  const [agree, setAgree] = useState(false);
  const [showTip, setShowTip] = useState(false);

  const handleWechatLogin = () => {
    if (!agree) {
      setShowTip(true);
      setTimeout(() => setShowTip(false), 2000);
      return;
    }
    onLogin();
  };

  return (
    <div className="h-full bg-white flex flex-col px-10 animate-in fade-in duration-700">
      {/* Logo 区 - 适当上移 */}
      <div className="flex-[1.8] flex flex-col items-center justify-center pt-6">
        <div className="w-28 h-28 bg-gradient-to-br from-[#007AFF] to-[#5856D6] rounded-[32px] flex items-center justify-center shadow-2xl shadow-blue-100 mb-8 relative">
          <BookOpen size={56} className="text-white" />
          <div className="absolute -right-2 -top-2 w-10 h-10 bg-amber-400 rounded-full border-4 border-white flex items-center justify-center shadow-lg">
            <Sparkles size={18} className="text-white" />
          </div>
        </div>
        <h1 className="text-4xl font-black tracking-tight text-gray-900">小柚英语</h1>
        <p className="text-[#8E8E93] text-base mt-4 font-medium opacity-80 tracking-wide">地道口语，AI 轻松陪练</p>
      </div>

      {/* 登录操作区 - 加宽加高 */}
      <div className="flex-1 flex flex-col justify-end pb-24 space-y-10">

        <div className="relative">
          {/* 未勾选协议时的气泡提示 */}
          {showTip && (
            <div className="absolute -top-14 left-1/2 -translate-x-1/2 bg-gray-900 text-white text-xs px-4 py-2 rounded-xl animate-bounce whitespace-nowrap shadow-xl">
              请先勾选同意协议
              <div className="absolute -bottom-1 left-1/2 -translate-x-1/2 w-2 h-2 bg-gray-900 rotate-45"></div>
            </div>
          )}

          {/* 微信一键登录按钮 - 显著加大尺寸 */}
          <button
            onClick={handleWechatLogin}
            className={`w-full h-16 rounded-[20px] font-bold text-xl flex items-center justify-center gap-4 transition-all active:scale-[0.97] shadow-2xl tracking-wide ${
              agree
              ? 'bg-[#07C160] text-white shadow-green-200 ring-4 ring-green-50'
              : 'bg-gray-100 text-gray-400 shadow-none'
            }`}
          >
            <MessageSquare size={28} fill={agree ? "white" : "currentColor"} className="opacity-90" />
            微信一键登录
          </button>
        </div>

        {/* 说明与协议文案 - 增加行间距与点击区域 */}
        <div className="flex items-start gap-4 px-2">
          <div
            onClick={() => setAgree(!agree)}
            className={`mt-1 w-6 h-6 rounded-full border-2 flex items-center justify-center transition-all cursor-pointer shrink-0 ${
              agree ? 'bg-[#007AFF] border-[#007AFF]' : 'border-gray-200 bg-gray-50'
            }`}
          >
            {agree && <CheckCircle2 size={14} className="text-white" strokeWidth={4} />}
          </div>
          <div className="text-[13px] text-[#8E8E93] leading-relaxed select-none py-0.5" onClick={() => setAgree(!agree)}>
            我已阅读并同意 <span className="text-[#007AFF] font-bold underline underline-offset-4 decoration-blue-100">《用户服务协议》</span> 与 <span className="text-[#007AFF] font-bold underline underline-offset-4 decoration-blue-100">《隐私政策》</span>
            <p className="mt-1 opacity-60 text-[11px]">首次登录将为您自动创建账号并开通试用会员</p>
          </div>
        </div>
      </div>

      {/* 底部装饰 */}
      <div className="pb-8 flex flex-col items-center gap-4">
        <div className="flex items-center gap-4 text-[#C7C7CC]">
          <div className="h-[1px] w-12 bg-gray-100"></div>
          <span className="text-[11px] font-bold uppercase tracking-[0.2em] opacity-30 italic">Powered by GPT-4o</span>
          <div className="h-[1px] w-12 bg-gray-100"></div>
        </div>
      </div>
    </div>
  );
};

const TabItem = ({ active, icon, label, onClick }) => (
